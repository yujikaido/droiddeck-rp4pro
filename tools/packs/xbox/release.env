# The published Xbox pack a build made outside Droid-Deck's CI pins (tag on DroidDeck-Components: pack-xbox-<first 16 hex>).
# A local build compiles xodus itself and its bytes differ from CI's, so pinning the local pack made every MaliBridge APK
# ask for a pack that was never published (404: "Couldn't download the Xbox components", v0.5.5.1 to v0.5.6-test6).
# 59420a98 was built by Droid-Deck CI from e871557b (10-29), whose tools/xbox sources (backend.lock.json, patches, prepare.py,
# runtime.lock.json) are the ones here; update both lines whenever tools/xbox changes.
XBOX_PACK_SHA256=59420a98861213452f063d198cf34570bfcd7d59668696c517d84ccc7386822d
XBOX_PACK_SIZE=14185622
