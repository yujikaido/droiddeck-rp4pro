# The published DirectAudio pack a release build must pin (tag on DroidDeck-Components:
# pack-directaudio-<first 16 hex of the digest>). tools/release/check_pack_pins.py fails an APK whose
# built pack differs, because a fresh install downloads exactly these bytes.
DIRECTAUDIO_PACK_SHA256=fd65f0c1e68234cac18796cfd7d43dad46334988dad1eb20fc082952d83efa7e
DIRECTAUDIO_PACK_SIZE=22574
