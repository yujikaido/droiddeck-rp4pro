# Published proot pack for a build that did not compile libproot.so into the APK.
# CI builds embed the binary and publish their own pack; this pin is what a source
# build downloads. Tag on DroidDeck-Components: pack-proot-<first 16 hex of the digest>.
# Update both lines when source builds should pick up a newer proot.
# 5a2b7284 (the earlier pin) fails with the Ubuntu runtime (the guest exits at once); 172bb48b works.
PROOT_PACK_SHA256=172bb48b00150b4292ba171089abecdf7243c06edddd68bf42dddb8c5bb24e4e
PROOT_PACK_SIZE=98502
