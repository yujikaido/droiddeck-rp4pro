GAME_TU_DEBUG = "DROIDDECK_GAME_TU_DEBUG"
SYNC_KEYS = ("BL_SYNC", "BL_SYNC_FALLBACK", "BL_FSYNC_FIRST", "BL_SYNC_MIN_NOFILE", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC", "PROTON_NO_NTSYNC", "WINEESYNC")
SEED_REDISTS = "/usr/local/bin/droiddeck-seed-redists"
PACK_KEYS = ("WINESERVER", "BL_SYNC_PACK", "WINEESYNC", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC")


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


DOTNET_FEX = {
    "FEX_TSOENABLED": "1",
    "FEX_VECTORTSOENABLED": "1",
    "FEX_MEMCPYSETTSOENABLED": "1",
    "FEX_HALFBARRIERTSOENABLED": "1",
    "FEX_X87REDUCEDPRECISION": "0",
}


def game_files(exe):
    """Lower-cased names of the files next to the game's executable and one directory below."""
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:
    """What a fix gets to look at: the executable, its launch arguments and the files beside it."""

    def __init__(self, exe, args, app_id=None, bridge=False):
        self.exe = exe
        self.args = args
        self.app_id = app_id
        self.bridge = bridge
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)


FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        return DOTNET_FEX, [], ".NET runtime: FEX with full TSO"


@fix
def unity_memory_ordering(game):
    if {"unityplayer.so", "gameassembly.so", "unityplayer.dll"} & game.files:
        return {"FEX_TSOENABLED": "1"}, [], "Unity: FEX with TSO"


# Main TSO and the half barriers on, the slow vector and memcpy ordering off: the ordering a game
# needs when its threads hand data to each other without the fences x86 never needed.
ORDERED_FEX = {"FEX_TSOENABLED": "1", "FEX_HALFBARRIERTSOENABLED": "1"}


def is_re_engine(game):
    return "re_chunk_000.pak" in game.files


@fix
def re_engine_memory_ordering(game):
    """RE Engine games (RE2/3/4/7/8, DMC5, Monster Hunter Rise...) hang minutes in with a Wine
    critical-section error when x86 memory ordering is not kept (box64 issue 1124: frequent at
    STRONGMEM=0, rare at 1). Main TSO and the half barriers stay on whatever the general FEX
    preset says; a game's own FEX preset still wins."""
    if is_re_engine(game):
        return ORDERED_FEX, [], "RE Engine: FEX main TSO and half barriers kept on (it hangs without)"


def is_beyond_good_and_evil(game):
    return game.stem == "bge" and "settingsapplication.exe" in game.files


@fix
def beyond_good_and_evil_tso(game):
    """Beyond Good & Evil (D3D8, one busy main thread) runs 13-22 fps on an RP4 Pro with FEX's main TSO on
    and a steady 60 with it off; a game's own FEX preset still wins."""
    if is_beyond_good_and_evil(game):
        return {"FEX_TSOENABLED": "0"}, [], "Beyond Good & Evil: FEX main TSO off (13-22 fps with it on)"


@fix
def beyond_good_and_evil_frame_cap(game):
    """Steam's 60 fps limit does not hold here (about 65 through the bridge) and the cutscene sound drifts."""
    if is_beyond_good_and_evil(game):
        return {"DXVK_FRAME_RATE": "60"}, [], "Beyond Good & Evil: capped at 60 fps (cutscene sound drifts above it)"


# The FEX choices DROIDDECK_CPU_PRESETS=off turns off (the .NET and Unity ones predate the switch and stay).
CPU_FIXES = (re_engine_memory_ordering, beyond_good_and_evil_tso)
CPU_PRESETS = "DROIDDECK_CPU_PRESETS"
CPU_LEVELS = ("off", "on")


def cpu_preset_level(env, app_id, path):
    """DROIDDECK_CPU_PRESETS from the game's own environment, else the shared one, else the
    session's: off (no per-engine FEX choice) or on (the default: what keeps a game from hanging)."""
    value = env.get(CPU_PRESETS)
    try:
        with open(path, encoding="utf-8") as source:
            config = json.load(source)
        value = config.get("shared", {}).get(CPU_PRESETS, value)
        value = config.get("games", {}).get(app_id, {}).get(CPU_PRESETS, value)
    except (OSError, ValueError, AttributeError):
        pass
    value = (value or "on").strip().lower() if isinstance(value, str) or value is None else "on"
    value = {"0": "off", "false": "off", "no": "off", "1": "on", "true": "on", "yes": "on"}.get(value, value)
    return value if value in CPU_LEVELS else "on"


@fix
def godot_vulkan(game):
    if is_godot(game) and not game.has_arg("--rendering-driver"):
        return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"


@fix
def godot_sentry(game):
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry and ("coreclr.dll" in game.files or "godotsharp.dll" in game.files):
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


@fix
def d3dgear_hook(game):
    """D3DGear's capture DLL left beside a game (The Crew 2) is loaded by it and hooks the DXGI swapchain;
    under Wine the hook faults over a thousand times within seconds and the game never presents again:
    black screen while the sound keeps playing."""
    if "d3dgear64.dll" in game.files:
        return {"WINEDLLOVERRIDES": "d3dgear64=d"}, [], "D3DGear capture hook off (it stops the game drawing)"


@fix
def deep_rock_gdk_raytracing(game):
    if game.stem == "fsd-wingdk-shipping" and not any(game.has_arg(arg) for arg in ("-raytracing", "-noraytracing")):
        return {}, ["-noraytracing", "-ini:Engine:[/Script/Engine.RendererSettings]:r.RayTracing=False"], "Deep Rock Galactic GDK: ray tracing off (D3D12 pipeline creation fails on Thor)"


@fix
def arkham_city_x87(game):
    """Batman: Arkham City (BatmanAC.exe, also started through BmLauncher.exe beside it) leans on x87
    and stops with Unreal's "Fatal error!" right after start when FEX reduces its precision."""
    if "batmanac.exe" in game.files:
        return {"FEX_X87REDUCEDPRECISION": "0"}, [], "Batman: Arkham City: FEX with full x87 precision"



@fix
def teardown_vsync(game):
    if game.stem == "teardown":
        return {"vblank_mode": "2"}, [], "Teardown: OpenGL keeps the game's own vsync"


@fix
def protonfixes_off(game):
    if game.stem in ("blackops3", "darksoulsremastered"):
        return {"PROTONFIXES_DISABLE": "1"}, [], "umu-protonfixes off (its ALSA audio and VC++ installer steps fail here)"


@fix
def caravan_sandwitch_feature_level(game):
    if "caravansandwitch.exe" in game.files or game.stem == "caravansandwitch-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Caravan SandWitch: D3D12 feature level 12_1 (12_2 hands it mesh shader pipelines vkd3d-proton cannot build)"


@fix
def robocop_rogue_city_feature_level(game):
    """vkd3d-proton turns mesh shaders off on Adreno, but 12_2 still advertises them, and UE5 then builds mesh
    pipelines with no pipeline layout that crash Turnip on launch."""
    if "robocop.exe" in game.files or game.stem == "robocop-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "RoboCop: Rogue City: D3D12 feature level 12_1"


@fix
def reskate_feature_level(game):
    if "skate.exe" in game.files and "reskate.dll" in game.files:
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "ReSkate (skate.): D3D12 feature level 12_1"


@fix
def cyberpunk_feature_level(game):
    if game.stem == "cyberpunk2077" or (
        game.stem == "redprelauncher"
        and os.path.isfile(os.path.join(os.path.dirname(game.exe), "bin", "x64", "Cyberpunk2077.exe"))
    ):
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Cyberpunk 2077: D3D12 feature level 12_1"


HPL_SHADOW_GAMES = {
    "282140": "SOMA",
    "57300": "Amnesia: The Dark Descent",
    "239200": "Amnesia: A Machine for Pigs",
}


@fix
def hpl_shadow_maps(game):
    name = HPL_SHADOW_GAMES.get(game.app_id or "")
    if name and game.bridge:
        return ({"MESA_EXTENSION_OVERRIDE": "-GL_ATI_fragment_shader"}, [],
                "%s (HPL engine): GL_ATI_fragment_shader hidden on the Mali bridge, so its shadow maps work on Zink" % name,
                "%s (HPL engine): GL_ATI_fragment_shader left as the player set it in MESA_EXTENSION_OVERRIDE "
                "(nothing added)" % name)


TILER_OFF_GAMES = {
    "1332010": "Stray",
}


@fix
def dxvk_tiler_mode_off(game):
    name = TILER_OFF_GAMES.get(game.app_id or "")
    if name and game.bridge:
        return ({"DXVK_CONFIG": "dxvk.tilerMode=False"}, [],
                "%s: DXVK tiler mode off on the Mali bridge, so the GPU doesn't wait on the render thread" % name,
                "%s: DXVK tiler mode left as the player set it in DXVK_CONFIG (nothing added)" % name)


# D3D11 games that refuse feature level 11_0 ("You need at least D3D_FEATURE_LEVEL_11_1"). DXVK
# offers 11_1 only with vertexPipelineStoresAndAtomics, which no Mali driver reports (so the bridge
# reports it off); d3d11.maxFeatureLevel takes precedence over that check. Per game: a game that
# runs at 11_0 today and asks for 11_1 first would be moved to 11_1 by a blanket setting.
FL11_1_GAMES = {
    "1593500": ("God of War", "gow"),
}


def app_id_beside(game):
    """The Steam app id a file beside the executable names (steam_appid.txt, or AppId= in flt.ini)."""
    folder = os.path.dirname(game.exe)
    for name, pattern in (("steam_appid.txt", r"\s*([0-9]{1,10})\s*"), ("flt.ini", r"(?ims).*?^\s*AppId\s*=\s*([0-9]{1,10})\s*$.*")):
        if name not in game.files:
            continue
        try:
            real = next((n for n in os.listdir(folder) if n.lower() == name), name)
            with open(os.path.join(folder, real), encoding="utf-8", errors="replace") as source:
                match = re.fullmatch(pattern, source.read(4096))
        except OSError:
            continue
        if match:
            return match.group(1)
    return None


@fix
def d3d11_feature_level_11_1(game):
    if not game.bridge:
        return None
    entry = FL11_1_GAMES.get(game.app_id or "")
    if not entry:
        named = [e for e in FL11_1_GAMES.items() if e[1][1] == game.stem]
        entry = named[0][1] if named and app_id_beside(game) == named[0][0] else None
    if entry:
        name = entry[0]
        return ({"DXVK_CONFIG": "d3d11.maxFeatureLevel=11_1"}, [],
                "%s: D3D11 feature level 11_1 offered on the Mali bridge (the game will not start at 11_0)" % name,
                "%s: D3D11 feature level left as the player set it in DXVK_CONFIG (nothing added)" % name)


def add_words(own, words):
    """The player's MESA_EXTENSION_OVERRIDE with the fix's words added; an extension the player names stays theirs."""
    own_words = (own or "").split()
    named = {w.lstrip("+-") for w in own_words}
    added = [w for w in words.split() if w.lstrip("+-") not in named]
    return " ".join(own_words + added)


def add_dxvk_options(own, options):
    """The player's DXVK_CONFIG with the fix's options added; an option the player sets stays theirs."""
    def key(entry):
        return entry.split("=", 1)[0].strip()
    own = (own or "").strip().rstrip(";").strip()
    named = {key(e) for e in own.split(";") if e.strip()}
    added = [e.strip() for e in options.split(";") if e.strip() and key(e) not in named]
    return "; ".join(([own] if own else []) + added)


ADDED_FIXES = {
    "MESA_EXTENSION_OVERRIDE": add_words,
    "DXVK_CONFIG": add_dxvk_options,
}


class Note(str):
    """A fix's session log line, with the line said instead when the player's value already had everything."""
    def __new__(cls, text, names=(), kept=None):
        note = super().__new__(cls, text)
        note.names = frozenset(names)
        note.kept = kept
        return note

    def line(self, kept_names):
        added = [name for name in self.names if name in ADDED_FIXES]
        if self.kept and added and all(name in kept_names for name in added):
            return self.kept
        return str(self)


def skip_red_launcher(command):
    """Cyberpunk 2077's prelauncher opens REDlauncher, a Qt WebEngine window that hands over to the
    game half a minute later and then stays up beside it, well over a core busy for as long as the
    game runs. The game is started itself instead; the prelauncher's own --launcher-skip started it
    twice."""
    if len(command) > 2 and os.path.basename(command[2]).lower() == "redprelauncher.exe":
        game = os.path.join(os.path.dirname(command[2]), "bin", "x64", "Cyberpunk2077.exe")
        if os.path.isfile(game):
            print("droiddeck-game-env: REDlauncher skipped", file=sys.stderr)
            return command[:2] + [game] + command[3:]
    return command


UBISOFT_LAUNCHER = "drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher"
UBISOFT_SETTINGS = "drive_c/users/steamuser/AppData/Local/Ubisoft Game Launcher/settings.yaml"


def overlay_off(text):
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if re.fullmatch(r"overlay:\s*(#.*)?", line))
    except StopIteration:
        if lines and not lines[-1].strip():
            lines.pop()
        return "\n".join(lines + ["overlay:", "  enabled: false", "  warning_enabled: false"]) + "\n"
    end = start + 1
    for index in range(start + 1, len(lines)):
        if lines[index].strip() and not lines[index].startswith("  "):
            break
        if lines[index].strip():
            end = index + 1
    block = lines[start + 1:end]
    for key in ("enabled", "warning_enabled"):
        entry = "  %s: false" % key
        found = [i for i, line in enumerate(block) if line.split(":", 1)[0] == "  " + key]
        if found:
            block[found[0]] = entry
        else:
            block.append(entry)
    return "\n".join(lines[:start + 1] + block + lines[end:]) + "\n"


def ubisoft_overlay_off(env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    if not (prefix / UBISOFT_LAUNCHER).is_dir():
        return
    settings = prefix / UBISOFT_SETTINGS
    try:
        text = settings.read_text(encoding="utf-8") if settings.exists() else ""
        updated = overlay_off(text)
        if updated == text:
            return
        settings.parent.mkdir(parents=True, exist_ok=True)
        handle, staged = tempfile.mkstemp(prefix=".settings-", dir=settings.parent)
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as target:
                target.write(updated)
            if settings.exists():
                os.chmod(staged, settings.stat().st_mode & 0o7777)
            os.replace(staged, settings)
        except BaseException:
            os.unlink(staged)
            raise
        print("droiddeck-game-env: Ubisoft Connect overlay turned off", file=sys.stderr)
    except (OSError, UnicodeDecodeError) as error:
        print("droiddeck-game-env: Ubisoft Connect overlay left as is (%s)" % error, file=sys.stderr)


BGE_VIDEO = r"[Software\\Ubisoft\\Beyond Good & Evil\\SettingsApplication.INI\\Basic video]"
BGE_PICTURE_STAMP = ".droiddeck-bge-picture"
# "Antialiasing" in its settings is the Blurryness slider (0-10), a full-screen blur; with it up or Flare on, the
# picture is a washed-out grey with streaks on Mali. AfterFx stays as it is: the game plays right with it on.
BGE_PICTURE_OFF = ("Blurryness", "Flare")


def wineserver_running(prefix):
    """True while a wineserver serves [prefix]: Wine's server runs in /tmp/.wine-<uid>/server-<dev>-<inode>."""
    try:
        info = os.stat(prefix)
    except OSError:
        return False
    name = "server-%x-%x" % (info.st_dev, info.st_ino)
    try:
        pids = os.listdir("/proc")
    except OSError:
        return False
    for pid in pids:
        if pid.isdigit():
            try:
                if os.path.basename(os.readlink("/proc/%s/cwd" % pid)) == name:
                    return True
            except OSError:
                pass
    return False


def picture_off(text):
    """[text] (a user.reg) with BGE_PICTURE_OFF set to 0 in BGE_VIDEO, or None while that section is missing."""
    lines = text.split("\n")
    inside = found = False
    for index, line in enumerate(lines):
        if line.startswith("["):
            inside = line.startswith(BGE_VIDEO)
            found = found or inside
        elif inside:
            for name in BGE_PICTURE_OFF:
                if line.startswith('"%s"=' % name):
                    lines[index] = '"%s"=dword:00000000' % name
    return "\n".join(lines) if found else None


def beyond_good_and_evil_picture(command, env, wait=15):
    """Turns the blur and flare passes off once, the first launch after the game's own settings were imported
    (support.bat at first start); a player who turns them on again in Game Settings keeps them. Edits user.reg only
    once no wineserver holds it (Proton waits for that too before the game), else tries again next launch."""
    if len(command) < 3 or os.path.basename(command[2]).lower() != "bge.exe":
        return
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    stamp, registry = prefix / BGE_PICTURE_STAMP, prefix / "user.reg"
    if stamp.exists() or not registry.is_file():
        return
    try:
        ends = time.monotonic() + wait
        while wineserver_running(prefix):
            if time.monotonic() > ends:
                print("droiddeck-game-env: Beyond Good & Evil picture settings left for the next launch (Wine still running)",
                      file=sys.stderr)
                return
            time.sleep(0.5)
        text = registry.read_text(encoding="utf-8", errors="surrogateescape")
        updated = picture_off(text)
        if updated is None:
            return
        if updated != text:
            handle, staged = tempfile.mkstemp(prefix=".user-", dir=prefix)
            try:
                with os.fdopen(handle, "w", encoding="utf-8", errors="surrogateescape", newline="") as target:
                    target.write(updated)
                os.chmod(staged, registry.stat().st_mode & 0o7777)
                os.replace(staged, registry)
            except BaseException:
                os.unlink(staged)
                raise
        stamp.write_text("Blurryness and Flare turned off once\n")
        print("droiddeck-game-env: Beyond Good & Evil: Antialiasing (blur) and Flare off", file=sys.stderr)
    except OSError as error:
        print("droiddeck-game-env: Beyond Good & Evil picture settings left as is (%s)" % error, file=sys.stderr)


def offline_without_anticheat(command, env):
    """Start the configured game executable when the player opts into launching without EAC."""
    if (env.get("DROIDDECK_ANTICHEAT_OFFLINE") != "1" or len(command) <= 2
            or command[1] != "waitforexitandrun"
            or not re.fullmatch(r"start_protected_game(?:_?x64|_?64)?\.exe",
                                os.path.basename(command[2]), re.IGNORECASE)):
        return command
    folder = os.path.dirname(command[2])
    try:
        with open(os.path.join(folder, "EasyAntiCheat", "settings.json"), encoding="utf-8-sig") as source:
            executable = json.load(source).get("executable")
    except (OSError, ValueError, AttributeError):
        return command
    if not isinstance(executable, str) or not executable:
        return command
    relative = os.path.normpath(executable.replace("\\", "/"))
    game = os.path.join(folder, relative)
    if os.path.isabs(relative) or relative.startswith("..") or not os.path.isfile(game):
        return command
    # Resolve symlinks before accepting an executable inside the game directory.
    root = os.path.realpath(folder)
    if os.path.commonpath((root, os.path.realpath(game))) != root:
        return command
    if os.path.normcase(os.path.abspath(game)) == os.path.normcase(os.path.abspath(command[2])):
        return command
    print("droiddeck-game-env: started without Easy Anti-Cheat (offline only)", file=sys.stderr)
    return command[:2] + [game] + command[3:]


def engine_fixes(exe, args, app_id=None, bridge=False, level="on"):
    """Environment and extra arguments a game needs because of what it is built with. [level]:
    DROIDDECK_CPU_PRESETS (cpu_preset_level); off leaves out the CPU_FIXES."""
    game = Game(exe, args, app_id, bridge)
    env, extra, notes = {}, [], []
    for check in (FIXES if level != "off" else [f for f in FIXES if f not in CPU_FIXES]):
        found = check(game)
        if found:
            for name, value in found[0].items():
                if name == "WINEDLLOVERRIDES" and env.get(name):
                    value = env[name] + ";" + value
                env[name] = value
            extra += found[1]
            notes.append(Note(found[2], found[0], found[3] if len(found) > 3 else None))
    return env, extra, notes


def win_components(compat, app_id):
    """The game's Windows components put into its prefix; returns their WINEDLLOVERRIDES entries."""
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def game_gpu(env):
    if GAME_TU_DEBUG not in env:
        return env
    result = env.copy()
    value = result.pop(GAME_TU_DEBUG)
    if value:
        result["TU_DEBUG"] = value
    else:
        result.pop("TU_DEBUG", None)
    return result


def vram_cap(env):
    """Puts the session's VRAM cap ahead of the game's own DXVK settings, so a game profile can still raise it."""
    value = env.get("BL_VRAM_MB", "")
    if not re.fullmatch(r"[1-9][0-9]{0,6}", value):
        return env
    result = env.copy()
    cap = "dxgi.maxDeviceMemory = %d" % int(value)
    own = result.get("DXVK_CONFIG", "").strip().strip(";").strip()
    result["DXVK_CONFIG"] = cap + "; " + own if own else cap
    return result


def parse_cores(text):
    """CPU numbers from a list such as "0-3,6"; None when the text is not one."""
    cores = set()
    for part in text.replace(" ", "").split(","):
        match = re.fullmatch(r"(\d{1,3})(?:-(\d{1,3}))?", part)
        if not match:
            return None
        first, last = int(match.group(1)), int(match.group(2) or match.group(1))
        if last < first:
            return None
        cores.update(range(first, last + 1))
    return cores or None


def online_cores():
    try:
        with open("/sys/devices/system/cpu/online") as f:
            cores = parse_cores(f.read().strip())
    except OSError:
        cores = None
    return cores or os.sched_getaffinity(0) | set(range(os.cpu_count() or 0))


def game_cores(env):
    """Pins the game to the cores its profile names, in place of the session's game cores."""
    text = env.get("DROIDDECK_GAME_CORES", "").strip()
    if not text:
        return
    cores = parse_cores(text)
    chosen = cores & online_cores() if cores else None
    if not chosen:
        print("droiddeck-game-env: ignoring game cores %r" % text, file=sys.stderr)
        return
    try:
        os.sched_setaffinity(0, chosen)
        print("droiddeck-game-env: game cores %s" % ",".join(map(str, sorted(chosen))), file=sys.stderr)
    except OSError as error:
        print("droiddeck-game-env: could not use game cores %r (%s)" % (text, error), file=sys.stderr)


def placement():
    return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-cpu-placement"))


def auto_game_cores(env, module=None):
    """On a chip with small in-order cores the game runs on the others, so Windows does not hand half its
    workers to the A510s (droiddeck-cpu-placement). A pick of the player's or the game's wins. A game
    started by a Steam thread that droiddeck-cpu-placement holds on the small cores inherited that hold;
    it gets its own cores back either way."""
    if game_id(env) is None:
        return
    if any(env.get(name, "").strip() for name in ("DROIDDECK_GAME_CORES", "BL_GAME_CPUS")):
        return
    try:
        module = module or placement()
        modes = module["mode"](env)
        if not modes:
            return
        topology = module["Topology"]()
        small = topology.little()
        if not small:
            return
        current = os.sched_getaffinity(0)
        own = "WINE_CPU_TOPOLOGY" in env or "PROTON_CPU_TOPOLOGY" in env
        wanted = topology.game() if "game" in modes and not own else set()
        if wanted:
            chosen = current & wanted or wanted
        elif "stack" in modes and current <= small:
            chosen = set(topology.cores)
        else:
            return
        if chosen == current:
            return
        os.sched_setaffinity(0, chosen)
        if wanted:
            print("droiddeck-game-env: game on cores %s, the small cores %s are left to Steam (BL_AUTO_CORES=0 turns this off)"
                  % (",".join(map(str, sorted(chosen))), ",".join(map(str, sorted(small)))), file=sys.stderr)
        else:
            print("droiddeck-game-env: game on every core (it inherited Steam's hold on the small cores)", file=sys.stderr)
    except Exception as error:
        print("droiddeck-game-env: automatic game cores not applied (%s)" % error, file=sys.stderr)


def core_speeds(cores, root="/sys/devices/system/cpu"):
    """Each core's capacity, else its top clock; None when some core reports neither."""
    for name in ("cpu_capacity", "cpufreq/cpuinfo_max_freq"):
        speeds = {}
        for core in cores:
            try:
                with open("%s/cpu%d/%s" % (root, core, name)) as f:
                    speeds[core] = int(f.read().strip())
            except (OSError, ValueError):
                break
        else:
            return speeds
    return None


def fastest_first(cores):
    """The cores, fastest first; cores of equal or unknown speed keep their numeric order."""
    cores = sorted(cores)
    speeds = core_speeds(cores)
    return sorted(cores, key=lambda core: -speeds[core]) if speeds else cores


def proton_cpu_limit(command, env):
    """This game's entry in Proton's own default_cpu_limit list: a core count, another value such as "P" as text, or None."""
    app_id = env.get("SteamGameId", "")
    if not command or not app_id.isdigit():
        return None
    try:
        if os.path.getsize(command[0]) > 4 * 1024 * 1024:
            return None
        with open(command[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    table = re.search(r"^default_cpu_limit = \{(.*?)^\}", text, re.M | re.S)
    match = table and re.search(r'^\s*"%s"\s*:\s*"?(\w+)' % app_id, table.group(1), re.M)
    if not match:
        return None
    value = match.group(1)
    return int(value) if value.isdigit() else value


def cpu_topology(env, command=()):
    """Windows sees the game's cores fastest first, so a thread a game pins to CPU 0 runs on the fastest core."""
    if "PROTON_CPU_TOPOLOGY" in env:
        return
    if "WINE_CPU_TOPOLOGY" in env:
        if env["WINE_CPU_TOPOLOGY"]:
            env["PROTON_CPU_TOPOLOGY"] = env["WINE_CPU_TOPOLOGY"]
        return
    picked = bool(env.get("DROIDDECK_GAME_CORES", "").strip() or env.get("BL_GAME_CPUS", "").strip())
    fastest = env.get("DROIDDECK_FASTEST_CORES", "").strip() != "0" and game_id(env) is not None
    if not (picked or fastest):
        return
    try:
        cores = sorted(os.sched_getaffinity(0))
    except OSError:
        return
    online = online_cores()
    if not cores or cores[-1] >= len(online):
        return
    picked = picked and not set(cores) >= online
    if fastest:
        limit = None if picked else proton_cpu_limit(command, env)
        if isinstance(limit, str):
            return
        cores = fastest_first(cores)[:limit or None]
    elif set(cores) >= online:
        return
    if cores == sorted(online):
        return
    env["WINE_CPU_TOPOLOGY"] = env["PROTON_CPU_TOPOLOGY"] = "%d:%s" % (len(cores), ",".join(map(str, cores)))
    print("droiddeck-game-env: Windows sees %d cores (%s)" % (len(cores), env["WINE_CPU_TOPOLOGY"]), file=sys.stderr)


def gl_vsync(env):
    """OpenGL stops waiting for each screen refresh; Steam's Frame Limit still holds the game through gamescope."""
    # Wine asks for interval 1 on every GL window, and WineD3D's front-buffer drawing (DirectDraw,
    # Direct3D 1-7) never lowers it, so those games ran at the refresh rate with no limit set.
    if "vblank_mode" in env or game_id(env) is None:
        return False
    env["vblank_mode"] = "0"
    return True


def game_images(env):
    if game_id(env) is None:
        return False
    env.setdefault("GAMESCOPE_WSI_MIN_IMAGE_COUNT", "8")
    env.setdefault("GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT", "1")
    return True


def apply_config(env, config, app_id, fixes=None, kept=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(config.get("shared", {}))
    fixes = dict(fixes or {})
    added = {name: fixes.pop(name) for name in ADDED_FIXES if name in fixes}
    for name, value in fixes.items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    for name, value in added.items():
        own = result.get(name)
        result[name] = ADDED_FIXES[name](own, value)
        if kept is not None and result[name] == ADDED_FIXES[name](own, ""):
            kept.add(name)
    game_dxvk = config.get("dxvkConfigGames", {})
    if not isinstance(game_dxvk, dict):
        raise ValueError("invalid game dxvk configuration")
    dxvk = game_dxvk.get(app_id, config.get("dxvkConfig"))
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    return result


GAME_DEBUG_CHANNELS = (
    "timestamp", "pid", "tid", "seh", "unwind", "threadname", "debugstr", "loaddll", "mscoree",
)
WINE_DEBUG_SELECTOR = re.compile(r"(?:(trace|warn|err|fixme))?([+-])([A-Za-z_][A-Za-z0-9_]*)")


def game_debug_channels(*values):
    """Normalize Wine selectors, retaining custom channels before required diagnostics."""
    selectors = {}
    for value in values:
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            continue
        for part in value.split(","):
            part = part.strip()
            match = WINE_DEBUG_SELECTOR.fullmatch(part)
            if match is None:
                continue
            key = (match[1] or "", match[3])
            # Move the last value to the end: global +/-all and per-class selectors
            # have ordered semantics, so replacing a value in its old position is wrong.
            selectors.pop(key, None)
            selectors[key] = part
    for channel in GAME_DEBUG_CHANNELS:
        key = ("", channel)
        selectors.pop(key, None)
        selectors[key] = "+" + channel
    formatted = ",".join(selectors.values())
    if len(formatted) > 8192:
        formatted = ",".join("+" + channel for channel in GAME_DEBUG_CHANNELS)
    return formatted


def apply_game_debug_logs(env, config, debug_dir):
    """Apply app-owned diagnostics to a real game, without editing its launch command."""
    if not isinstance(config, dict) or config.get("version") != 1 or config.get("gameDebugLogs") is not True:
        return env
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or len(debug_dir) > 8192
            or not os.path.isabs(debug_dir) or not os.path.isdir(debug_dir)):
        print("droiddeck-game-env: game debug logs skipped; session log directory unavailable", file=sys.stderr)
        return env
    result = dict(env)
    result.update({
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": debug_dir,
        "PROTON_CRASH_REPORT_DIR": debug_dir,
        "DXVK_LOG_PATH": debug_dir,
        "DXVK_LOG_LEVEL": "debug",
        "VKD3D_DEBUG": "info",
        "WINEDEBUG": game_debug_channels(env.get("WINEDEBUG"), env.get("PROTON_LOG")),
    })
    return result


# Exit-at-start diagnostics (steam-compatibility arm_exit_diag): the title closed at its last start without showing a frame,
# so this launch, and only this one, writes Proton's log, DXVK at info and vkd3d warnings into <session log folder>/exit-diag,
# which Send logs packs (each file cut to its last 4 MB). The flag is taken with one rename: a launch without one costs a
# single failed rename and gets nothing. The player's own log settings are kept. DD_EXIT_DIAG=0 turns it off.
EXIT_DIAG_ENV = (("PROTON_LOG", "1"), ("PROTON_LOG_DIR", None), ("DXVK_LOG_PATH", None), ("DXVK_LOG_LEVEL", "info"),
                 ("VKD3D_DEBUG", "warn"))


def take_exit_diag(app_id, env, debug_dir, home=None):
    """Returns (env, line): the environment for this launch and the session log line, or (env, None) when not armed."""
    if (env.get("DD_EXIT_DIAG", "1").strip().lower() in ("0", "off", "false", "no")
            or not re.fullmatch(r"[0-9]+", app_id or "")):
        return env, None
    flag = os.path.join(str(home or Path.home()), ".local/share/droiddeck-compat/exit-diag", app_id)
    try:
        os.replace(flag, flag + ".used")
    except OSError:
        return env, None
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or not os.path.isabs(debug_dir)
            or not os.path.isdir(debug_dir)):
        return env, ("app %s closed at its last start without showing a frame; exit diagnostics skipped (no session log "
                     "folder)" % app_id)
    out = os.path.join(debug_dir, "exit-diag")
    try:
        os.makedirs(out, exist_ok=True)
    except OSError as error:
        return env, "app %s: exit diagnostics skipped (%s)" % (app_id, error)
    result, kept = dict(env), []
    for key, value in EXIT_DIAG_ENV:
        if result.get(key) and not (key == "PROTON_LOG" and result[key] == "0"):
            kept.append(key)
            continue
        result[key] = out if value is None else value
    return result, ("app %s closed at its last start without showing a frame: Proton's log, DXVK info and vkd3d warnings "
                    "are on for this launch only (%s%s)" % (app_id, out, "; kept your " + ", ".join(kept) if kept else ""))


def bridge_feature_level(env):
    if env.get("BL_VKBRIDGE") != "1" or env.get("VKD3D_FEATURE_LEVEL") not in ("12_1", "12_2"):
        return None
    was = env["VKD3D_FEATURE_LEVEL"]
    env["VKD3D_FEATURE_LEVEL"] = "12_0"
    return "Mali bridge: VKD3D_FEATURE_LEVEL %s capped at 12_0 (no ray tracing or mesh shaders)" % was


def fast_cores_first(env, cpus=Path("/sys/devices/system/cpu")):
    """Windows CPU 0 on a fast core. Older PC games pin their main thread to CPU 0, the fastest core on
    a PC; on a phone chip cpu0 is a little core (Tales of Symphonia: 15 fps in battle on a Cortex-A55,
    30 on an A78). WINE_CPU_TOPOLOGY numbers the cores fastest first, from the device's own clocks;
    games that pin nothing are unaffected. Skipped when the game or the player set
    WINE_CPU_TOPOLOGY, chose the game cores (BL_GAME_CPUS), or set BL_FAST_CORES_FIRST=0.
    Returns a note when it set something."""
    if env.get("WINE_CPU_TOPOLOGY") or env.get("BL_GAME_CPUS") or env.get("BL_FAST_CORES_FIRST") == "0":
        return None
    clocks = {}
    for path in cpus.glob("cpu[0-9]*/cpufreq/cpuinfo_max_freq"):
        try:
            clocks[int(path.parent.parent.name[3:])] = int(path.read_text())
        except (OSError, ValueError):
            return None
    # Wine wants every host CPU 0..n-1 in the mapping; a gap means a core it can't place.
    if sorted(clocks) != list(range(len(clocks))) or len(set(clocks.values())) < 2:
        return None
    order = sorted(clocks, key=lambda cpu: (-clocks[cpu], cpu))
    if clocks[order[0]] == clocks[0]:
        return None
    env["WINE_CPU_TOPOLOGY"] = "%d:%s" % (len(order), ",".join(map(str, order)))
    return "fast cores first: WINE_CPU_TOPOLOGY=" + env["WINE_CPU_TOPOLOGY"]


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    """DROIDDECK_FORCE_SSBS=1 (a game's or the shared environment): preload libssbs.so into this
    Proton's Wine, which then keeps PSTATE.SSBS set across signal returns - speculative store
    bypass stays allowed, as force_ssbs.diff does inside a rebuilt ntdll. ARM64 Protons only: the
    library is aarch64 and only arm64 Wine has the signal path it fixes."""
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


INSTALL_SCRIPT = re.compile(r"^installscript.*\.vdf$", re.IGNORECASE)
LIBRARY_PATH = re.compile(r'"path"\s+"((?:[^"\\]|\\.)*)"')
GAME_LIBRARIES = ("/mnt/droiddeck", "/mnt/droiddeck-sd")


def runs(command, program):
    return any(arg.lower().replace("\\", "/").endswith(program) for arg in command)


def service_helper(command):
    """The client's service helper (legacycompat steamservice.exe /runfunc): it runs a game's install
    steps and, for games with Steam's CEG DRM, the "Updating executable" step (Just Cause 2, Mafia II)."""
    return runs(command, "steamservice.exe") and any(arg.lower() == "/runfunc" for arg in command)


def game_folder(root, env):
    """The installed game's folder, for a client helper Proton is given no install path for."""
    given = env.get("STEAM_COMPAT_INSTALL_PATH", "")
    if given and os.path.isdir(given):
        return given
    app = game_id(env)
    if not app:
        return None
    libraries = [root] + list(GAME_LIBRARIES)
    try:
        with open(os.path.join(root, "steamapps", "libraryfolders.vdf"), encoding="utf-8", errors="replace") as f:
            libraries += [path.replace("\\\\", "\\") for path in LIBRARY_PATH.findall(f.read())]
    except OSError:
        pass
    for library in dict.fromkeys(libraries):
        try:
            with open(os.path.join(library, "steamapps", "appmanifest_%s.acf" % app), encoding="utf-8", errors="replace") as f:
                found = re.search(r'"installdir"\s+"([^"]+)"', f.read(), re.IGNORECASE)
        except OSError:
            continue
        if found:
            folder = os.path.join(library, "steamapps", "common", found.group(1))
            if os.path.isdir(folder):
                return folder
    return None


def game_install_scripts(folder, depth=4):
    found = []
    base = folder.rstrip("/").count("/")
    for directory, dirs, files in os.walk(folder):
        if directory.count("/") - base >= depth:
            dirs[:] = []
        found += [os.path.join(directory, name) for name in files if INSTALL_SCRIPT.match(name)]
    return sorted(found)


def mark_install_scripts(command, env):
    """The client is about to run a game's install scripts: mark every process in them but a Vulkan
    runtime installer as already run first, so no redistributable installer starts - on first
    launch the shared ones may still be downloading, and on ARM64 Proton the VC++ ones stop with an
    error. Two client helpers run them: iscriptevaluator.exe, given the script, and the service
    helper (legacycompat steamservice.exe /runfunc, Just Cause 2), given none - its scripts are the
    game's own installscript*.vdf. Returns the evaluator's scripts (the service helper always runs,
    so it returns none)."""
    root = env.get("BL_X64_STEAM_ROOT") or env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    if runs(command, "iscriptevaluator.exe"):
        scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
        scripts = [path for path in scripts if os.path.isfile(path)]
        if not scripts:
            return []
        evaluator = True
    elif service_helper(command):
        folder = game_folder(root, env)
        scripts = [path for path in (game_install_scripts(folder) if folder else []) if os.path.isfile(path)]
        print("droiddeck-game-env: the client's service helper runs install steps for app %s; %d install script(s) to mark" % (
            game_id(env) or "?", len(scripts)), file=sys.stderr)
        # With none found still worth a pass: the shared redistributables may have landed since the last one.
        evaluator = False
    else:
        return []
    seed_env = dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts))
    if env.get("STEAM_COMPAT_DATA_PATH"):
        seed_env["DROIDDECK_SEED_PREFIX"] = env["STEAM_COMPAT_DATA_PATH"]
    try:
        run_bounded([SEED_REDISTS, root], seed_env, 60)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)
    return scripts if evaluator else []


def run_bounded(command, env, timeout):
    """Run command in its own process group, and on timeout end the whole group."""
    process = subprocess.Popen(command, env=env, stdout=sys.stderr, start_new_session=True)
    try:
        return process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            process.kill()
        process.wait()
        raise


INSTALL_STAMP = ".droiddeck-install-scripts"
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def read_vdf(text):
    tokens = iter(VDF_TOKEN.findall(text))

    def block():
        items = []
        for word, brace in tokens:
            if brace == "}":
                return items
            if brace:
                raise ValueError("a block without a name")
            value, opens = next(tokens, ("", "}"))
            if opens == "}":
                raise ValueError("a name without a value")
            items.append((re.sub(r"\\(.)", r"\1", word), block() if opens else re.sub(r"\\(.)", r"\1", value)))
        return items

    return block()


def run_keys(items, appid=""):
    appid = next((value for name, value in items if name.lower() == "appid" and isinstance(value, str)), appid)
    found = set()
    for name, value in items:
        if not isinstance(value, list):
            continue
        if any(isinstance(v, str) and re.fullmatch(r"process [0-9]+", n.lower()) for n, v in value):
            key = next((v for n, v in value if n.lower() == "hasrunkey" and isinstance(v, str)),
                       "HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\" + appid)
            found.add((key.lower(), name.lower()))
        found |= run_keys(value, appid)
    return found


DXVK_MEMORY_KEYS = ("dxgi.maxDeviceMemory", "dxgi.maxSharedMemory")
LOW_DXVK_MEMORY_MB = 1024
LOW_DXVK_MEMORY_PHONE_GB = 7.0  # "8 GB" phones report about 7.3-7.7 GB


def mem_total_gb(path="/proc/meminfo"):
    try:
        with open(path, encoding="ascii", errors="replace") as info:
            for line in info:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / (1024 * 1024)
    except (OSError, ValueError, IndexError):
        pass
    return 0.0


def game_exe(command):
    """The Windows program the command starts: its last argument ending in .exe, if any."""
    exes = [part for part in command if part.lower().endswith(".exe")]
    return exes[-1] if exes else None


def dxvk_conf_path(command, env):
    """The dxvk.conf DXVK will read: DXVK_CONFIG_FILE, else dxvk.conf next to the game (any case)."""
    named = env.get("DXVK_CONFIG_FILE", "")
    if named:
        return named if os.path.isfile(named) else None
    exe = game_exe(command)
    folders = [os.path.dirname(exe)] if exe else []
    try:
        folders.append(os.getcwd())
    except OSError:
        pass
    for folder in folders:
        try:
            with os.scandir(folder or ".") as entries:
                for entry in entries:
                    if entry.name.lower() == "dxvk.conf" and entry.is_file():
                        return entry.path
        except OSError:
            continue
    return None


def dxvk_conf_values(path, keys, exe_name=None):
    """The last value of each key in a dxvk.conf (lines `key = value`, # comments; [program.exe]
    sections count only for that program)."""
    found = {}
    section_ok = True
    wanted = {key.lower(): key for key in keys}
    with open(path, encoding="utf-8", errors="replace") as conf:
        for raw in conf:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("[") and line.endswith("]"):
                name = line[1:-1].strip().strip('"').lower()
                section_ok = not exe_name or name == exe_name.lower()
                continue
            if "=" not in line or not section_ok:
                continue
            key, value = (part.strip() for part in line.split("=", 1))
            if key.lower() in wanted:
                found[wanted[key.lower()]] = value.strip('"')
    return found


def low_dxvk_memory(command, env, meminfo="/proc/meminfo"):
    """One session log line when the game's dxvk.conf caps DXVK's memory far below the phone's
    (dxgi.maxDeviceMemory / maxSharedMemory under 1024 MB on a phone of 8 GB or more): games that
    size their texture pool from it (GTA V) then stream textures in and out all the time. The file
    is the player's and stays as it is."""
    total = mem_total_gb(meminfo)
    if total < LOW_DXVK_MEMORY_PHONE_GB:
        return None
    path = dxvk_conf_path(command, env)
    if not path:
        return None
    exe = game_exe(command)
    try:
        values = dxvk_conf_values(path, DXVK_MEMORY_KEYS, os.path.basename(exe) if exe else None)
    except OSError:
        return None
    low = []
    for key in DXVK_MEMORY_KEYS:
        try:
            mb = int(float(values[key]))
        except (KeyError, ValueError):
            continue
        if 0 < mb < LOW_DXVK_MEMORY_MB:
            low.append("%s = %d" % (key, mb))
    if not low:
        return None
    own = env.get("DXVK_CONFIG", "").lower()
    overridden = [key for key in DXVK_MEMORY_KEYS if key.lower() in own]
    line = ("%s sets %s (MB), far below this phone's %.1f GB: a game that sizes its texture pool from it streams textures "
            "in and out all the time (stutter while moving). The file is left as it is; 2048 or more there is worth a try"
            % (path, " and ".join(low), total))
    if overridden:
        line += " (DXVK_CONFIG sets %s too, and DXVK takes that one)" % " and ".join(overridden)
    return line


def registry_values(path):
    found, section = set(), None
    with open(path, encoding="utf-8", errors="replace") as reg:
        for line in reg:
            if line.startswith("["):
                section = line[1:line.find("]")].replace("\\\\", "\\").lower() if "]" in line else None
            elif section and line.startswith('"') and '"=' in line:
                found.add((section, line[1:line.index('"=')].replace("\\\\", "\\").lower()))
    return found


def has_run(key, value, values):
    path = key[len("hkey_local_machine\\"):] if key.startswith("hkey_local_machine\\") else None
    if path is None:
        return False
    views = [path]
    if path.startswith("software\\"):
        views.append("software\\wow6432node\\" + path[len("software\\"):])
    return any((view, value) in values for view in views)


def scripts_digest(scripts):
    digest = hashlib.sha256()
    for path in sorted(scripts):
        digest.update(os.path.basename(path).encode() + b"\0")
        digest.update(Path(path).read_bytes())
    return digest.hexdigest()


def install_scripts_done(scripts, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if (prefix / INSTALL_STAMP).read_text().strip() != scripts_digest(scripts):
            return False
        keys = set()
        for path in scripts:
            keys |= run_keys(read_vdf(Path(path).read_text(encoding="utf-8", errors="replace")))
        values = registry_values(prefix / "system.reg")
    except (OSError, ValueError):
        return False
    return bool(keys) and all(has_run(key, value, values) for key, value in keys)


def record_install_scripts(digest, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if prefix.is_dir():
            staged = prefix / (INSTALL_STAMP + ".tmp")
            staged.write_text(digest + "\n")
            staged.replace(prefix / INSTALL_STAMP)
    except OSError as error:
        print("droiddeck-game-env: install scripts not recorded (%s)" % error, file=sys.stderr)


def directaudio_settings(env):
    if "directaudio" not in env.get("WINE_AUDIO_DRIVER", "").split(","):
        return env
    for name, value in list(env.items()):
        if name.startswith("AUDIO_DIRECT_"):
            env["BANNER_" + name] = value
    return env


def die_with_parent():
    """In the child before exec: a SIGKILL of droiddeck-game-env reaches the helper too, as it did when the
    helper was exec'd in its place."""
    try:
        import ctypes
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
    except Exception:
        pass


def run_as_if_execed(launch, launch_env):
    """Run the helper as a child (to log its end) yet keep exec's behaviour for whoever started it: a stop
    sent to this process is passed on to the helper, and a kill of it ends the helper too."""
    process = subprocess.Popen(launch, env=launch_env, preexec_fn=die_with_parent)
    forwarded = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT)
    previous = {}

    def forward(number, _frame):
        try:
            process.send_signal(number)
        except OSError:
            pass

    for number in forwarded:
        try:
            previous[number] = signal.signal(number, forward)
        except (OSError, ValueError):
            pass
    try:
        while True:
            try:
                return process.wait()
            except InterruptedError:
                continue
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def start(launch, launch_env, digest, helper=False):
    if helper:
        # Steam ends a CEG helper it has given up on (about 105 s for Mafia II and Just Cause 2); a
        # missing "ended" line after the "started" one means Steam stopped it.
        began = time.monotonic()
        print("droiddeck-game-env: service helper started %s" % time.strftime("%H:%M:%S"), file=sys.stderr, flush=True)
        code = run_as_if_execed(launch, launch_env)
        print("droiddeck-game-env: service helper ended %s after %.0f s (exit code %d)" % (
            time.strftime("%H:%M:%S"), time.monotonic() - began, code), file=sys.stderr, flush=True)
        if code < 0:
            # Ended by a signal: end the same way, so Steam sees what it saw when the helper was exec'd.
            signal.signal(-code, signal.SIG_DFL)
            os.kill(os.getpid(), -code)
        return code
    if digest:
        code = subprocess.run(launch, env=launch_env, check=False).returncode
        if code == 0:
            record_install_scripts(digest, launch_env)
        return code
    return os.execvpe(launch[0], launch, launch_env)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    env = game_gpu(os.environ.copy())
    mic_enabled = env.get("BL_MIC_ENABLED")
    debug_dir = env.get("BL_DEBUG_DIR", "")
    scripts = mark_install_scripts(command, env)
    if scripts and install_scripts_done(scripts, env):
        print("droiddeck-game-env: install scripts already run in this prefix; evaluator skipped", file=sys.stderr)
        return 0
    try:
        digest = scripts_digest(scripts) if scripts else None
    except OSError:
        digest = None
    app_id = game_id(env)
    helper = service_helper(command)
    if app_id:
        gl_default = gl_vsync(env)
        waiting = len(command) > 1 and command[1] == "waitforexitandrun"
        if waiting:
            game_images(env)
        fixes, notes, kept = {}, [], set()
        if waiting:
            command = skip_red_launcher(command)
            ubisoft_overlay_off(env)
            beyond_good_and_evil_picture(command, env)
            level = cpu_preset_level(env, app_id, Path.home() / ".config/droiddeck/game-environment.json")
            fixes, extra, notes = engine_fixes(command[2], command[3:], app_id,
                                                env.get("BL_VKBRIDGE") == "1", level) if len(command) > 2 else ({}, [], [])
            if not gl_default:
                fixes.pop("vblank_mode", None)
            command += extra
            components = win_components(env.get("STEAM_COMPAT_DATA_PATH", ""), app_id)
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
        path = Path.home() / ".config/droiddeck/game-environment.json"
        config = {}
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
            if waiting:
                if "vblank_mode" in config.get("shared", {}):
                    fixes.pop("vblank_mode", None)
                env = apply_config(env, config, app_id, fixes, kept)
            else:
                env = apply_config(env, sync_config(config, app_id), app_id)
        except FileNotFoundError:
            if waiting:
                env = apply_config(env, {"version": 1}, app_id, fixes, kept)
        except (OSError, ValueError, TypeError, AttributeError):
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        for note in notes:
            print("droiddeck-game-env: " + note.line(kept), file=sys.stderr)
        if waiting or helper:
            # The service helper too: when Steam gives up on "Updating executable" its Proton log is
            # the only trace of what the helper was doing.
            before_debug = env
            env = apply_game_debug_logs(env, config, debug_dir)
            if env is not before_debug:
                print("droiddeck-game-env: game debug logs enabled for this %s" % (
                    "launch" if waiting else "service helper"), file=sys.stderr)
        if waiting:
            env, line = take_exit_diag(app_id, env, debug_dir)
            if line:
                print("droiddeck-game-env: " + line, file=sys.stderr)
            cores = fast_cores_first(env)
            if cores:
                print("droiddeck-game-env: " + cores, file=sys.stderr)
        if gl_default and env.get("vblank_mode") == "0":
            print("droiddeck-game-env: OpenGL does not wait for the screen refresh (vblank_mode=0)", file=sys.stderr)
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun":
        command = offline_without_anticheat(command, env)
    if mic_enabled == "0":
        env["AUDIO_DIRECT_MIC"] = "0"
    env = directaudio_settings(env)
    env = vram_cap(env)
    try:
        note = low_dxvk_memory(command, env)
    except Exception as error:  # a diagnostic: never in the way of the launch
        note = None
        print("droiddeck-game-env: dxvk.conf not checked (%s)" % error, file=sys.stderr)
    if note:
        print("droiddeck-game-env: " + note, file=sys.stderr)
    note = bridge_feature_level(env)
    if note:
        print("droiddeck-game-env: " + note, file=sys.stderr)
    env = force_ssbs(command, env)
    game_cores(env)
    auto_game_cores(env)
    cpu_topology(env, command)
    try:
        xbox = runpy.run_path(str(Path(__file__).with_name("droiddeck-xbox")))
    except Exception as error:
        print("droiddeck-game-env: Xbox support unavailable (%s); stock launch" % error, file=sys.stderr)
        xbox = {"launch": lambda command, env: None}
    try:
        xbox_result = xbox["launch"](command, env)
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print("droiddeck-game-env: Xbox launch could not start (%s)" % error, file=sys.stderr)
        return 1
    if xbox_result is not None:
        return xbox_result
    sync = load_sync()
    launch, launch_env = select_sync(command, env, sync)
    if launch[0] != command[0]:
        try:
            return start(launch, launch_env, digest, helper)
        except OSError as error:
            print("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error), file=sys.stderr)
            launch, launch_env = command, without_pack(launch_env, env)
            record_stock(sync, launch, launch_env)
    return start(launch, launch_env, digest, helper)


if __name__ == "__main__":
    sys.exit(main())
