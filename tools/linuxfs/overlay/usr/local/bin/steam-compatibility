BL_STORE_SETUP = """
bl_store_launch() {
  [ "${verb:-}" = waitforexitandrun ] || return 0
  if [ -x /usr/local/bin/droiddeck-open-url ]; then
    mkdir -p /tmp/droiddeck-browser
    ln -sfn /usr/local/bin/droiddeck-open-url /tmp/droiddeck-browser/xdg-open
    [ -n "${BL_LAUNCH_DIR:-}" ] && printf '%s
' "$BL_LAUNCH_DIR" > /tmp/droiddeck-browser/launch-dir
    PATH="/tmp/droiddeck-browser:$PATH"; export PATH
  fi
  if [ "${BL_DEBUG_BROWSER:-}" = 1 ]; then
    WINEDEBUG="${WINEDEBUG:+$WINEDEBUG,}+shell,+winebrowser"; export WINEDEBUG
  fi
  [ -x /usr/local/bin/droiddeck-store-launch ] || return 0
  /usr/local/bin/droiddeck-store-launch "$@"
  rc=$?
  [ $rc -eq 10 ] && BL_STORE_EXIT=1
  [ $rc -eq 11 ] && exit 0
  [ $rc -eq 12 ] && exit 1
  return 0
}

bl_run() {
  if [ -x /usr/local/bin/droiddeck-steamvr-flat ] && /usr/local/bin/droiddeck-steamvr-flat "${verb:-}"; then
    set -- /usr/local/bin/droiddeck-steamvr-game "$@"
  fi
  if [ -n "${BL_STORE_EXIT:-}" ]; then
    "$@"
    rc=$?
    /usr/local/bin/droiddeck-store-launch --exited --code "$rc" "${BL_STORE_ARGS[@]}" || true
    exit $rc
  fi
  exec "$@"
}
"""

BL_DESKTOP_GPU_SETUP = """
bl_desktop_gpu() {
  local name saved gpu=/usr/local/bin/droiddeck-gpu
  local names=(LD_PRELOAD LD_LIBRARY_PATH ENABLE_VK_LAYER_VALVE_steam_overlay_1 ENABLE_VK_LAYER_VALVE_steam_fossilize_1)
  if [ -n "${BL_DESKTOP_GPU_CHILD:-}" ]; then
    for name in "${names[@]}"; do
      saved=BL_GPU_SAVED_$name
      [ -n "${!saved+x}" ] || continue
      export "$name=${!saved}"
      unset "$saved"
    done
    return 0
  fi
  [ "${BL_DESKTOP:-}" = 1 ] && [ "${verb:-}" = waitforexitandrun ] && [ -x "$gpu" ] || return 0
  local choice=${BL_DESKTOP_GPU:-on}
  case "${choice,,}" in off | 0 | no | false) return 0 ;; esac
  case " $* " in *iscriptevaluator*) return 0 ;; esac
  local clear=()
  for name in "${names[@]}"; do
    [ -n "${!name+x}" ] || continue
    export "BL_GPU_SAVED_$name=${!name}"
    clear+=(-u "$name")
  done
  echo "droiddeck-gpu: the desktop starts this game on the GPU" >&2
  exec env "${clear[@]}" "$gpu" "$0" "$verb" "$@"
}
bl_desktop_gpu "$@"
"""
BL_COMPONENTS_SETUP = """
bl_components() {
  base=$1
  cm_dir="${HOME:-/root}/.local/share/droiddeck-components"
  cm_list="$cm_dir/desired.tsv"
  [ "${verb:-}" = waitforexitandrun ] || return 0
  case "${STEAM_COMPAT_DATA_PATH:-}" in ''|*/compatdata/0|*/compatdata/0/|*/compatdata/0-*) return 0 ;; esac
  [ -f "$cm_list" ] || return 0
  cm_app=${STEAM_COMPAT_DATA_PATH}
  while [[ "$cm_app" == */ ]]; do cm_app=${cm_app%/}; done
  cm_app=${cm_app##*/}
  if [[ "$cm_app" =~ ^(-?)([0-9]+)$ ]]; then
    cm_sign=${BASH_REMATCH[1]}
    cm_digits=${BASH_REMATCH[2]}
    while [[ ${#cm_digits} -gt 1 && "$cm_digits" == 0* ]]; do cm_digits=${cm_digits#0}; done
    if [[ ${#cm_digits} -le 10 ]]; then
      cm_app=$((10#$cm_digits))
      [ "$cm_sign" = "-" ] && cm_app=$((-cm_app))
      if (( cm_app >= -2147483648 && cm_app <= 4294967295 && cm_app != 0 )); then
        (( cm_app < 0 )) && cm_app=$((cm_app + 4294967296))
      else
        cm_app=""
      fi
    else
      cm_app=""
    fi
  else
    cm_app=""
  fi
  if [ -z "$cm_app" ]; then
    echo "droiddeck-proton: components: invalid game prefix, left as it is" >&2
    return 0
  fi
  cm_tool=${base##*/}
  cm_build=$(awk 'NR == 1 { print $2 }' "$base/version" 2>/dev/null)
  cm_fixed=0
  cm_checked=0
  cm_selected=$(awk -F '\\t' -v app="$cm_app" -v tool="$cm_tool" -v build="$cm_build" '
    $2 == tool && $3 == build {
      rows[++count] = $0
      scopes[count] = $1
      comps[count] = $4
      if ($1 == app) specific[$4] = 1
    }
    END {
      for (i = 1; i <= count; i++)
        if (scopes[i] == app || (scopes[i] == "*" && !specific[comps[i]])) print rows[i]
    }
  ' "$cm_list")
  local cm_rows=() cm_files=() row h p
  local -A cm_sums=()
  while IFS=$'\\t' read -r scope t want comp rel sum src; do
    [ -n "$scope" ] || continue
    cm_rows+=("$comp"$'\\t'"$rel"$'\\t'"$sum"$'\\t'"$src")
    [ "$src" != "-" ] && [ -f "$base/$rel" ] && cm_files+=("$base/$rel")
  done <<< "$cm_selected"
  if [ ${#cm_files[@]} -gt 0 ]; then
    while read -r h p; do cm_sums["$p"]=$h; done < <(sha256sum -- "${cm_files[@]}" 2>/dev/null)
  fi
  for row in "${cm_rows[@]}"; do
    IFS=$'\\t' read -r comp rel sum src <<< "$row"
    cm_checked=$((cm_checked + 1))
    f="$base/$rel"
    if [ "$src" = "-" ]; then
      if [ -e "$f" ]; then rm -f "$f" && cm_fixed=$((cm_fixed + 1)); fi
      continue
    fi
    if [ -f "$f" ] && [ "${cm_sums[$f]:-}" = "$sum" ]; then continue; fi
    if [ ! -f "$src" ]; then
      echo "droiddeck-proton: components: $comp source missing ($src), left as it is" >&2
      continue
    fi
    mkdir -p "$(dirname "$f")"
    cp -f "$src" "$f.bl-new" && mv -f "$f.bl-new" "$f" || continue
    case "$rel" in *.so) chmod 755 "$f" ;; *) chmod 644 "$f" ;; esac
    cm_fixed=$((cm_fixed + 1))
  done
  [ "$cm_checked" -gt 0 ] && echo "droiddeck-proton: components: checked $cm_checked file(s) in $cm_tool for app $cm_app" >&2
  if [ "$cm_fixed" -gt 0 ]; then
    echo "droiddeck-proton: components: re-applied $cm_fixed of $cm_checked file(s) in $cm_tool before this launch" >&2
    printf '%s\\t%s\\t%s\\n' "$(date +%s)" "$cm_tool" "$cm_fixed" >> "$cm_dir/reapplied.log"
  fi
}
"""

# Valve's proton runs do_steampipe_fixups before anything else: when steampipe_fixups.json's mtime
# differs from files/steampipe_fixups_mtime it lstats every no_write_paths entry and writes the mtime
# only when all of them are there. One missing listed file (d3d8.dll after a DXVK swap) so stops every
# launch, for good. This puts such files back from the launch table, DroidDeck's saved original or the
# stock depot; failing that it writes the mtime the way proton does, so the step is skipped. It never
# touches a file the json does not list.
BL_FIXUPS_PY = r"""
import hashlib, json, os, re, shutil, sys
base, cm_dir = sys.argv[1], sys.argv[2]
manifest = os.path.join(base, "steampipe_fixups.json")
marker = os.path.join(base, "files", "steampipe_fixups_mtime")
def say(text):
    print("droiddeck-proton: steampipe fixups: " + text, file=sys.stderr, flush=True)
def safe(name):
    return re.sub(r"[^A-Za-z0-9._+-]+", "_", name).strip("_") or "unnamed"
def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as source:
        for chunk in iter(lambda: source.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()
try:
    stamp = str(os.path.getmtime(manifest))
except OSError:
    sys.exit(0)
try:
    with open(marker) as source:
        if source.readline().strip() == stamp:
            sys.exit(0)
except OSError:
    pass
try:
    with open(manifest) as source:
        listed = json.load(source)["no_write_paths"]
except Exception:
    sys.exit(0)
missing = [rel for rel in listed if isinstance(rel, str) and not os.path.lexists(os.path.join(base, rel))]
if not missing:
    sys.exit(0)
tool = os.path.basename(base.rstrip("/"))
try:
    with open(os.path.join(base, "version")) as source:
        parts = source.readline().split()
except OSError:
    parts = []
build = parts[1] if len(parts) > 1 else (parts[0] if parts else "")
sources = {}
try:
    with open(os.path.join(cm_dir, "desired.tsv")) as table:
        for line in table:
            row = line.rstrip("\n").split("\t")
            if len(row) == 7 and row[1] == tool and row[2] == build and row[4] in missing and row[6] != "-":
                sources.setdefault(row[4], []).append((row[0] != "*", row[6], row[5]))
except OSError:
    pass
original = os.path.join(cm_dir, "store", "original-%s-%s-" % (safe(tool), safe(build)))
stock = None
try:
    with open(os.path.join(base, ".droiddeck-esync.json")) as source:
        stock = json.load(source).get("stock")
except Exception:
    pass
restored, left = [], []
for rel in missing:
    candidates = [(path, digest) for _, path, digest in sorted(sources.get(rel, []))]
    for comp in ("dxvk", "vkd3d", "fex"):
        if os.path.isfile(original + comp + "/.complete"):
            candidates.append((original + comp + "/" + rel, None))
    if isinstance(stock, str) and os.path.realpath(stock) != os.path.realpath(base):
        candidates.append((os.path.join(stock, rel), None))
    target = os.path.join(base, rel)
    for path, digest in candidates:
        try:
            if not os.path.isfile(path) or (digest and sha256(path) != digest):
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            temp = target + ".bl-new"
            shutil.copyfile(path, temp)
            os.chmod(temp, 0o644)
            os.replace(temp, target)
            restored.append(rel)
            break
        except OSError:
            continue
    else:
        left.append(rel)
if restored:
    say("put back %d listed file(s) in %s that were missing (%s)" % (len(restored), tool, ", ".join(restored)))
if left:
    try:
        with open(marker, "w") as out:
            out.write(stamp + "\n")
        say("%d listed file(s) missing in %s and no copy to put back (%s); the step is marked done so Proton starts"
            % (len(left), tool, ", ".join(left)))
    except OSError as error:
        say("%d listed file(s) missing in %s (%s) and the step could not be marked done (%s)" % (len(left), tool, ", ".join(left), error))
"""

BL_FIXUPS_SETUP = """
bl_fixups() {
  [ -f "$1/steampipe_fixups.json" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 -I - "$1" "${HOME:-/root}/.local/share/droiddeck-components" <<'BL_FIXUPS_EOF' || true
""" + BL_FIXUPS_PY + """BL_FIXUPS_EOF
}
"""


BL_GAME_CPUS_SETUP = """
bl_game_cpus() {
  [ -n "${BL_GAME_CPUS:-}" ] || return 0
  command -v taskset >/dev/null 2>&1 || return 0
  BL_TASKSET="taskset -c $BL_GAME_CPUS"
  echo "droiddeck-proton: game cores $BL_GAME_CPUS" >&2
}
"""

BL_LIBPATH_SETUP = """
bl_libpath() {
  export PROTON_USE_PIPEWIRE=${PROTON_USE_PIPEWIRE:-0}
  [ -n "${LD_LIBRARY_PATH:-}" ] || return 0
  local kept= dir old_ifs=$IFS
  IFS=:
  for dir in $LD_LIBRARY_PATH; do
    case $dir in
      "" | */steamrtarm64 | */steamrtarm64/*) ;;
      *) kept=${kept:+$kept:}$dir ;;
    esac
  done
  IFS=$old_ifs
  if [ -n "$kept" ]; then export LD_LIBRARY_PATH="$kept"; else unset LD_LIBRARY_PATH; fi
}
"""

BL_IDTECH3_SETUP = """
bl_idtech3() {
  BL_EXTRA_ARGS=()
  case "${SteamAppId:-${STEAM_COMPAT_APP_ID:-}}" in
    2200|2350|9010|6020) ;;
    *) return 0 ;;
  esac
  case " $* " in
    *r_fullscreen*|*r_mode*|*r_customwidth*|*r_customheight*)
      echo "droiddeck-proton: Quake-engine title; its launch options set the video mode, left as they are" >&2
      return 0 ;;
  esac
  w=${BL_WIDTH:-1280}
  h=${BL_HEIGHT:-720}
  BL_EXTRA_ARGS=(+set r_fullscreen 0 +set r_mode -1 +set r_customwidth "$w" +set r_customheight "$h")
  echo "droiddeck-proton: Quake-engine title: windowed at ${w}x${h}" >&2
}
"""

# Source games report VAC-secure or insecure only in their console, written to console.log only with -condebug.
# The app keeps the switch and the records in /root: the x86-64 client runs games with its own HOME.
BL_VACDIAG_SETUP = """
bl_vacdiag() {
  [ -f /root/.droiddeck-vac-diagnostics ] || return 0
  [ "${verb:-}" = waitforexitandrun ] || return 0
  local exe= a dir added=no app=${SteamAppId:-${STEAM_COMPAT_APP_ID:-0}}
  for a in "$@"; do case $a in *.exe|*.EXE) exe=$a ;; esac; done
  [ -n "$exe" ] || return 0
  dir=$(dirname "$exe")
  # Source: <mod>/gameinfo.txt beside the exe. Source 2: game/bin/win64/<exe> with game/<mod>/gameinfo.gi.
  if ls "$dir"/*/gameinfo.txt >/dev/null 2>&1 || ls "$dir"/../../*/gameinfo.gi >/dev/null 2>&1; then
    case " $* " in
      *" -condebug "*) echo "droiddeck-proton: vac-diag: app $app already has -condebug" >&2 ;;
      *) BL_EXTRA_ARGS+=(-condebug); added=yes
         echo "droiddeck-proton: vac-diag: app $app is a Source title; launched with -condebug" >&2 ;;
    esac
  else
    added=not-source
    echo "droiddeck-proton: vac-diag: app $app is not a Source title; it keeps no console log to read" >&2
  fi
  case " $* " in
    *" -insecure "*) echo "droiddeck-proton: vac-diag: app $app has -insecure in its launch options - it can never be VAC-secure this way" >&2 ;;
  esac
  printf '%s\tapp %s\tcondebug %s\t%s\n' "$(date +%s)" "$app" "$added" "${exe##*/}" >> /root/.droiddeck-vac-launches
}
"""

# Steam's shader pre-caching runs its D3D driver query through every Proton tool at each start, as
# "run <client>/bin/d3ddriverquery64.exe" in compatdata/0. Here it has never succeeded (exit 1 every time), and each
# run started Wine in compatdata/0, where the two Protons upgrade the prefix back and forth for many seconds while the
# game starts. Steam gets the same failure without starting Wine; other verbs and prefixes are left alone.
BL_DRIVER_QUERY_SKIP = """
case "$verb:${1##*/}:${STEAM_COMPAT_DATA_PATH%/}" in
  run:d3ddriverquery64.exe:*/compatdata/0 | run:d3ddriverquery.exe:*/compatdata/0)
    echo "droiddeck-proton: Steam's D3D driver query is not run (it fails here and would start Wine in compatdata/0)" >&2
    exit 1 ;;
esac
"""

BL_DIRECTAUDIO_SETUP = """
bl_is_steam_installscript_target() {
  local target=${1:-}
  local steam_root=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}
  local helper="$steam_root/legacycompat/iscriptevaluator.exe"
  [ -f "$helper" ] && [[ -n "$target" && "$target" -ef "$helper" ]]
}

bl_directaudio() {
  case "${verb:-}" in
    run|waitforexitandrun|runinprefix) ;;
    *) return 0 ;;
  esac
  base=$1
  [ -n "${BL_DIRECTAUDIO:-}" ] || return 0
  [ -d "$BL_DIRECTAUDIO" ] || return 0
  if bl_is_steam_installscript_target "${2:-}"; then
    echo "droiddeck-proton: DirectAudio skipped for Steam's install-script evaluator" >&2
    return 0
  fi
  streamer=$(cat "${XDG_RUNTIME_DIR:-/tmp}/droiddeck-remote-play" 2>/dev/null)
  if [ -n "$streamer" ] && kill -0 "$streamer" 2>/dev/null; then
    WINE_AUDIO_DRIVER=pulse
    export WINE_AUDIO_DRIVER
    echo "droiddeck-proton: a Remote Play client is connected - game audio goes through PulseAudio so the stream carries it" >&2
    return 0
  fi
  version=$("$base/files/bin-arm64/wine" --version 2>/dev/null)
  major=${version#wine-}
  major=${major%%.*}
  if [ "$major" != "11" ]; then
    echo "droiddeck-proton: DirectAudio left off - it is built for Wine 11 and this Proton is '${version:-unknown}'. Pairing them would be silent rather than broken, so it is not worth guessing." >&2
    return 0
  fi
  winepulse="$base/files/lib/wine/aarch64-unix/winepulse.so"
  if [ ! -f "$winepulse" ]; then
    echo "droiddeck-proton: DirectAudio left off - no winepulse.so to read this Proton's audio interface from" >&2
    return 0
  fi
  if grep -aq PsCreateSystemThread "$winepulse"; then set=linux-wine11-systhread; else set=linux-wine11; fi
  da="$BL_DIRECTAUDIO/$set"
  if [ ! -d "$da/lib/wine" ]; then
    echo "droiddeck-proton: DirectAudio left off - no driver set for the $set interface is staged" >&2
    return 0
  fi
  WINEDLLPATH="$da/lib/wine${WINEDLLPATH:+:$WINEDLLPATH}"
  export WINEDLLPATH
  for name in $(compgen -e); do
    case $name in
      AUDIO_DIRECT_*) export "BANNER_$name=${!name}" ;;
    esac
  done
  WINE_AUDIO_DRIVER="directaudio,pulse"
  export WINE_AUDIO_DRIVER
  pfx="${STEAM_COMPAT_DATA_PATH:-}/pfx"
  reg="$pfx/user.reg"
  if [ -f "$reg" ]; then
    for pair in system32:aarch64-windows syswow64:i386-windows; do
      dir="$pfx/drive_c/windows/${pair%%:*}"
      src="$da/lib/wine/${pair#*:}/winedirectaudio.drv"
      if [ -d "$dir" ] && [ -f "$src" ] && [ "$(readlink "$dir/winedirectaudio.drv" 2>/dev/null)" != "$src" ]; then
        ln -sfn "$src" "$dir/winedirectaudio.drv.bl-new" && mv -f "$dir/winedirectaudio.drv.bl-new" "$dir/winedirectaudio.drv"
      fi
    done
    key='[Software\\\\Wine\\\\Drivers]'
    if [ "$(readlink "$pfx/drive_c/windows/system32/winedirectaudio.drv" 2>/dev/null)" != "$da/lib/wine/aarch64-windows/winedirectaudio.drv" ]; then
      echo "droiddeck-proton: DirectAudio could not be placed in the prefix; Proton's own audio stays" >&2
    elif ! BL_KEY="$key" awk 'index($0, "[") == 1 { inside = index($0, ENVIRON["BL_KEY"] " ") == 1 } inside && index($0, "\\"Audio\\"=") == 1 { last = $0 } END { exit last != "\\"Audio\\"=\\"directaudio,pulse\\"" }' "$reg" 2>/dev/null; then
      printf '\\n%s %s\\n"Audio"="directaudio,pulse"\\n' "$key" "$(date +%s)" >> "$reg"
      echo "droiddeck-proton: DirectAudio selected in the prefix" >&2
      srv="${BL_WINE_SERVER_BASE:-/tmp/.wine-$(id -u)}/server-$(printf '%x-%x' $(stat -c '%d %i' "$pfx" 2>/dev/null || echo 0 0))/socket"
      if [ -S "$srv" ]; then
        echo "droiddeck-proton: a wineserver is already running for this prefix; DirectAudio may only engage on the next launch" >&2
      fi
    fi
  else
    echo "droiddeck-proton: no prefix yet - DirectAudio takes effect the next time this game starts" >&2
  fi
  echo "droiddeck-proton: DirectAudio ready (Wine $major, $set)" >&2
}
"""

LAUNCHER_SH = """#!/bin/bash
verb=$1; shift
steam_root=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}
for fake in /usr/local/lib/libfakeinput.so /usr/local/lib/libblsession.so; do
  if [ -f "$fake" ]; then
    case ":${LD_PRELOAD:-}:" in
      *":$fake:"*) ;;
      *) LD_PRELOAD="$fake${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
    esac
  fi
done
audit=/usr/local/lib/libblaudit.so
if [ -n "${PROOT_FP_KEY:-}" ] && [ -f "$audit" ]; then
  case ":${LD_AUDIT:-}:" in
    *":$audit:"*) ;;
    *) LD_AUDIT="$audit${LD_AUDIT:+:$LD_AUDIT}"; export LD_AUDIT ;;
  esac
fi
depot=
libraries=$(printf '%%s\\n' "$steam_root" /mnt/droiddeck-sd; sed -n 's/^[[:space:]]*"path"[[:space:]]*"\\(.*\\)"[[:space:]]*$/\\1/p' "$steam_root/steamapps/libraryfolders.vdf" 2>/dev/null)
for name in %s; do
 best=0
 while IFS= read -r library; do
  candidate="$library/steamapps/common/$name"
  [ -d "$candidate/files/bin-arm64" ] && [ -x "$candidate/proton" ] || continue
  build=0
  read -r build _ 2>/dev/null < "$candidate/version"
  case $build in "" | *[!0-9]*) build=0 ;; esac
  if [ -z "$depot" ] || [ "$build" -gt "$best" ]; then
    depot=$candidate
    best=$build
  fi
 done <<< "$libraries"
 [ -n "$depot" ] && break
done
if [ -n "$depot" ]; then
  bl_components "$depot"
  bl_fixups "$depot"
  bl_directaudio "$depot" "$@"
  bl_game_cpus
  bl_idtech3 "$@"
  bl_vacdiag "$@"
  bl_libpath
  BL_STORE_PROTON="$depot/proton"; export BL_STORE_PROTON
  bl_store_launch "$@"
  BL_STORE_ARGS=("$@")
  bl_run ${BL_TASKSET:-} /usr/local/bin/droiddeck-game-env "$depot/proton" "$verb" "$@" "${BL_EXTRA_ARGS[@]}"
fi
echo "droiddeck-proton: no ARM64 Proton depot yet - the client downloads one as this tool's dependency; retry the launch once it has" >&2
exit 1
"""
LAUNCHER_TEMPLATE = LAUNCHER_SH


