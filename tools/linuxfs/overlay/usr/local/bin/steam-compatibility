TOKEN = re.compile(r'\s*(?:"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*)')


def tokenize(text):
    tokens = []
    pos = 0
    while pos < len(text):
        m = TOKEN.match(text, pos)
        if not m or m.end() == pos:
            break
        pos = m.end()
        if m.group(2):
            tokens.append(m.group(2))
        elif m.group(1) is not None:
            tokens.append('"' + m.group(1) + '"')
    return tokens


def find_block(tokens, path):
    """Index of the '{' opening the block at path, or None."""
    depth, want, i = 0, 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "{":
            depth += 1
        elif t == "}":
            depth -= 1
            if depth < want:
                return None
        elif depth == want and i + 1 < len(tokens) and tokens[i + 1] == "{":
            if t.lower() == '"%s"' % path[want].lower():
                if want == len(path) - 1:
                    return i + 1
                want += 1
        i += 1
    return None


def block_end(tokens, start):
    depth = 0
    for i in range(start, len(tokens)):
        if tokens[i] == "{":
            depth += 1
        elif tokens[i] == "}":
            depth -= 1
            if depth == 0:
                return i
    return len(tokens)


def serialize(tokens):
    out, depth, i = [], 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "}":
            depth -= 1
            out.append("\t" * depth + "}")
            i += 1
        elif i + 1 < len(tokens) and tokens[i + 1] == "{":
            out.append("\t" * depth + t)
            out.append("\t" * depth + "{")
            depth += 1
            i += 2
        else:
            out.append("\t" * depth + t + "\t\t" + tokens[i + 1])
            i += 2
    return "\n".join(out) + "\n"


def write_changed(path, text, mode=None):
    """Writes `text` to `path` only when it differs, through a rename so a reader never sees half a
    file. The session runs this script every 15 s for as long as the client does; rewriting files
    that have not changed cost a python start's worth of writes each time, and config.vdf is the
    client's own, which it may be writing at that moment. Returns whether anything was written."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            same = f.read() == text
    except OSError:
        same = False
    if not same:
        tmp = path + ".droiddeck"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    elif mode is not None and (os.stat(path).st_mode & 0o7777) != mode:
        os.chmod(path, mode)
    return not same


def display_name(base):
    try:
        with open(LABEL_FILE, encoding="utf-8") as f:
            label = f.read().strip().replace('"', "'").replace("\\", "")
    except OSError:
        label = ""
    return "%s (%s)" % (base, label) if label else base


def first_key(path, section):
    """The single key naming a block inside `section`, or None. Used to keep a third-party tool's
    own internal name, so a mapping the user already made against it keeps working."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            tokens = tokenize(f.read())
    except OSError:
        return None
    block = find_block(tokens, section)
    if block is None:
        return None
    for i in range(block + 1, block_end(tokens, block)):
        if tokens[i] == "}":
            break
        if i + 1 < len(tokens) and tokens[i + 1] == "{":
            return tokens[i].strip('"')
    return None


def manifest_entry_point(path):
    """The script a toolmanifest's commandline runs, relative to the tool directory."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            tokens = tokenize(f.read())
    except OSError:
        return None
    for i in range(len(tokens) - 1):
        if tokens[i].lower() == '"commandline"':
            command = tokens[i + 1].strip('"').split()
            if command:
                return command[0].lstrip("/")
    return None


def adopt_extras(tools):
    """Makes every other Proton in compatibilitytools.d launchable here, and returns the tool names
    to leave alone in CompatToolMapping - the whole point of installing one is to pick it per game,
    so register_default must not repoint it back at ours."""
    adopted = {}
    try:
        entries = sorted(os.listdir(tools))
    except OSError:
        return adopted
    for entry in entries:
        if entry in dict(OWN_TOOLS) or entry == FEX_TOOL or entry.startswith("."):
            continue
        tool_dir = os.path.join(tools, entry)
        manifest = os.path.join(tool_dir, "toolmanifest.vdf")
        if not os.path.isdir(tool_dir) or not os.path.isfile(manifest):
            continue
        original = manifest + ORIGINAL_SUFFIX
        legacy = manifest + LEGACY_ORIGINAL_SUFFIX
        if not os.path.isfile(original) and os.path.isfile(legacy):
            try:
                os.replace(legacy, original)
            except OSError:
                continue
        if not os.path.isfile(original):
            try:
                shutil.copy2(manifest, original)
            except OSError:
                continue
        entry_point = manifest_entry_point(original)
        if not entry_point or entry_point in (EXTRA_WRAPPER, LEGACY_EXTRA_WRAPPER):
            entry_point = "proton"
        if not os.path.exists(os.path.join(tool_dir, entry_point)):
            print("steam-compatibility: %s has no %s; left alone" % (entry, entry_point))
            continue
        compat_vdf = os.path.join(tool_dir, "compatibilitytool.vdf")
        name = first_key(compat_vdf, ["compatibilitytools", "compat_tools"]) or entry
        wrapper = os.path.join(tool_dir, EXTRA_WRAPPER)
        try:
            write_changed(wrapper, extra_wrapper_sh(entry_point), 0o755)
            write_changed(manifest, EXTRA_MANIFEST_VDF)
            write_changed(compat_vdf, EXTRA_COMPAT_TOOL_VDF % (name, display_name(entry)))
            legacy_wrapper = os.path.join(tool_dir, LEGACY_EXTRA_WRAPPER)
            if os.path.isfile(legacy_wrapper):
                os.unlink(legacy_wrapper)
        except OSError as e:
            print("steam-compatibility: could not adopt %s (%s)" % (entry, e))
            continue
        adopted[name] = entry
    return adopted


NOT_GAMES = frozenset((
    "228980",
    "1070560",
    "1391110",
    "1628350",
    "1493710",
    "3127680",
    "4183110",
    "4185400",
    "4427310",
    "4628740",
))


def libraries(steam_root):
    found = [steam_root]
    try:
        with open(os.path.join(steam_root, "steamapps", "libraryfolders.vdf"), encoding="utf-8", errors="replace") as f:
            found += [path.replace("\\\\", "\\") for path in re.findall(r'"path"\s+"((?:[^"\\]|\\.)*)"', f.read())]
    except OSError:
        pass
    found.append(LIBRARY + "-sd")
    return list(dict.fromkeys(found))


def installed_apps(steam_root):
    """App ids of the titles the client has installed, tools and runtimes excluded."""
    apps = set()
    for library in libraries(steam_root):
        steamapps = os.path.join(library, "steamapps")
        try:
            names = os.listdir(steamapps)
        except OSError:
            continue
        for name in names:
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", name)
            if m and m.group(1) not in NOT_GAMES:
                apps.add(m.group(1))
    return sorted(apps, key=int)


APPINFO_CACHE = {}
STEAM_PLAY_MANIFESTS = 891390


def launch_programs(config):
    """The Windows and Linux programs an app's launch options start, relative to its folder (lowercase, "/")."""
    launch = config.get("launch") if isinstance(config, dict) else None
    found = []
    for option in launch.values() if isinstance(launch, dict) else ():
        if not isinstance(option, dict) or not option.get("executable"):
            continue
        settings = option.get("config") if isinstance(option.get("config"), dict) else {}
        oslist = str(settings.get("oslist", "")).lower()
        if oslist and "windows" not in oslist and "linux" not in oslist:
            continue
        found.append(os.path.normpath(str(option["executable"]).replace("\\", "/")).lstrip("/").lower())
    return found


def launch_options(config):
    """An app's launch options as Steam lists them: executable, arguments, working folder, type and oslist."""
    launch = config.get("launch") if isinstance(config, dict) else None
    found = []
    for key, option in launch.items() if isinstance(launch, dict) else ():
        if not isinstance(option, dict) or not option.get("executable"):
            continue
        settings = option.get("config") if isinstance(option.get("config"), dict) else {}
        found.append({
            "key": str(key),
            "executable": str(option["executable"]),
            "arguments": str(option.get("arguments", "")),
            "workingdir": str(option.get("workingdir", "")),
            "type": str(option.get("type", "")).lower(),
            "oslist": str(settings.get("oslist", "")).lower(),
            "betakey": str(settings.get("betakey", "")),
        })
    return found


def appinfo_entries(path):
    import struct
    try:
        stamp = os.stat(path).st_mtime_ns
    except OSError:
        return {}
    cached = APPINFO_CACHE.get(path)
    if cached and cached[0] == stamp:
        return cached[1]
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return {}
    if len(data) < 8:
        return {}
    magic = struct.unpack_from("<I", data, 0)[0]
    if magic not in (0x07564427, 0x07564428, 0x07564429):
        return {}
    offset = 8
    strings = None
    try:
        if magic == 0x07564429:
            table = struct.unpack_from("<q", data, offset)[0]
            offset += 8
            count = struct.unpack_from("<I", data, table)[0]
            position = table + 4
            strings = []
            for _ in range(count):
                end = data.index(b"\0", position)
                strings.append(data[position:end].decode("utf-8", "replace"))
                position = end + 1
    except (ValueError, IndexError, struct.error):
        return {}
    header = 4 + 4 + 8 + 20 + 4 + (20 if magic >= 0x07564428 else 0)

    def section(position):
        result = {}
        while True:
            kind = data[position]
            position += 1
            if kind == 8:
                return result, position
            if strings is not None:
                key = strings[struct.unpack_from("<I", data, position)[0]]
                position += 4
            else:
                end = data.index(b"\0", position)
                key = data[position:end].decode("utf-8", "replace")
                position = end + 1
            if kind == 0:
                result[key], position = section(position)
            elif kind == 1:
                end = data.index(b"\0", position)
                result[key] = data[position:end].decode("utf-8", "replace")
                position = end + 1
            elif kind == 2:
                result[key] = struct.unpack_from("<i", data, position)[0]
                position += 4
            elif kind == 7:
                result[key] = struct.unpack_from("<Q", data, position)[0]
                position += 8
            else:
                raise ValueError("unknown appinfo field type %d" % kind)

    found = {}
    while offset + 8 <= len(data):
        try:
            app, size = struct.unpack_from("<II", data, offset)
        except struct.error:
            break
        if app == 0:
            break
        start = offset + 8
        offset = start + size
        try:
            info = section(start + header)[0].get("appinfo", {})
        except (ValueError, IndexError, struct.error):
            continue
        if not isinstance(info, dict):
            continue
        common = info.get("common", {}) if isinstance(info.get("common"), dict) else {}
        deck = common.get("steam_deck_compatibility")
        configuration = deck.get("configuration") if isinstance(deck, dict) else None
        recommended = configuration.get("recommended_runtime", "") if isinstance(configuration, dict) else ""
        entry = {
            "oslist": {part.strip().lower() for part in str(common.get("oslist", "")).split(",") if part.strip()},
            "osarch": str(common.get("osarch", "")).lower(),
            "type": str(common.get("type", "")).lower(),
            "recommended": str(recommended),
            "launch": launch_programs(info.get("config")),
            "launch_options": launch_options(info.get("config")),
        }
        if app == STEAM_PLAY_MANIFESTS:
            extended = info.get("extended", {})
            mappings = extended.get("app_mappings", {}) if isinstance(extended, dict) else {}
            entry["app_mappings"] = {str(m.get("appid", key)): str(m.get("tool", "")) for key, m in mappings.items()
                                     if isinstance(m, dict)} if isinstance(mappings, dict) else {}
        found[str(app)] = entry
    APPINFO_CACHE[path] = (stamp, found)
    return found


def appinfo_platforms(path, wanted):
    entries = appinfo_entries(path)
    return {app: (entries[app]["oslist"], entries[app]["osarch"], entries[app]["type"]) for app in wanted if app in entries}


def valve_picks(steam_root):
    entries = appinfo_entries(os.path.join(steam_root, "appcache", "appinfo.vdf"))
    mapped = {app for app, tool in entries.get(str(STEAM_PLAY_MANIFESTS), {}).get("app_mappings", {}).items() if tool}
    picks = set()
    for app, entry in entries.items():
        if app in NOT_GAMES or entry["type"] not in PLAYABLE_TYPES:
            continue
        if entry["oslist"] and "windows" not in entry["oslist"]:
            continue
        if entry["recommended"] or app in mapped:
            picks.add(app)
    return sorted(picks, key=int)


def native_targets(steam_root, apps):
    wanted = {str(app) for app in apps if str(app) not in NOT_GAMES}
    if not wanted:
        return {}
    targets = {}
    for app, (oslist, osarch, kind) in appinfo_platforms(os.path.join(steam_root, "appcache", "appinfo.vdf"), wanted).items():
        if kind not in PLAYABLE_TYPES or "linux" not in oslist:
            continue
        if "arm64" in osarch or "aarch64" in osarch:
            targets[app] = None
            continue
        if "windows" in oslist:
            targets[app] = NATIVE_CHOICE
            continue
        targets[app] = FEX_TOOL
    return targets


def app_manifest(steam_root, app):
    for library in libraries(steam_root):
        try:
            with open(os.path.join(library, "steamapps", "appmanifest_%s.acf" % app), encoding="utf-8", errors="replace") as f:
                return tokenize(f.read())
        except OSError:
            continue
    return None


def manifest_flags(tokens):
    for i in range(len(tokens) - 1):
        if tokens[i].lower() == '"stateflags"':
            value = tokens[i + 1].strip('"')
            return int(value) if value.isdigit() else 0
    return 0


def tool_downloads(steam_root):
    """(app, "install" or "update") for each tool the client has yet to install or bring up to date."""
    wanted = []
    for app in REQUIRED_TOOLS:
        tokens = app_manifest(steam_root, app)
        if tokens is None:
            wanted.append((app, "install"))
        elif not manifest_flags(tokens) & FULLY_INSTALLED or manifest_flags(tokens) & UPDATE_REQUIRED:
            wanted.append((app, "update"))
    return wanted


def fex_missing(steam_root):
    missing = []
    for app in FEX_DEPENDENCIES:
        if not any(os.path.isfile(os.path.join(library, "steamapps", "appmanifest_%s.acf" % app))
                   for library in libraries(steam_root)):
            missing.append(app)
    return missing


def fex_wanted_marker():
    return os.path.join(os.environ.get("HOME", "/root"), ".config", "droiddeck", "fex-wanted")


def request_app(steam_root, app):
    import subprocess
    client = os.path.join(steam_root, "steamrtarm64", "steam")
    if not os.access(client, os.X_OK):
        return []
    try:
        process = subprocess.Popen([client, "steam://install/%s" % app], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return []
    try:
        process.wait(timeout=REQUEST_HANDOFF_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    return [app]


def request_fex(steam_root, asked):
    client = os.path.join(steam_root, "steamrtarm64", "steam")
    missing = fex_missing(steam_root)
    if not os.access(client, os.X_OK) or any(app in asked for app in missing):
        return []
    for app in missing:
        asked.add(app)
        requested = request_app(steam_root, app)
        if requested:
            return requested
    return []


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            value = json.load(f)
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def write_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    return write_changed(path, json.dumps(value, indent=1, sort_keys=True) + "\n")


class locked:
    def __init__(self, directory=None):
        self.path = os.path.join(directory or COMPAT_DIR, "lock")

    def __enter__(self):
        import fcntl
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


def state_path(name, directory=None):
    return os.path.join(directory or COMPAT_DIR, name)


def unrunnable(name, runnable):
    low = name.lower()
    return low not in runnable and (low.startswith("proton") or low == LEGACY_TOOL or low.startswith("droiddeck-proton"))


def app_order(app):
    return (len(app), app)


DEFERRED_GAME_TOOL = object()
NATIVE_CHOICE = object()


def plan_mapping(current, installed, runnable, default, auto, native=None, picks=(), overrides=None, managed=None,
                 native_choices=(), suggested=None, present=(), why=None, new_tools=None, override_why=None):
    """`suggested` (app id -> tool, from the app's known-games table, see suggested_games) takes the
    default's place for that title only: a title that follows the default, or is new, gets it, and
    a tool the owner picked in the client's menu stays, as it does against the default. A per-game
    pick in the app (`overrides`) beats it.
    `present`: tools that are installed but not (yet) listed by the client; a title on one of them is
    not stale. `why`: filled with the reason for every change (app id -> text).
    `new_tools` (see new_title_tools): app id -> tool for titles that have no prefix yet; it comes after the
    known-games table and before the native build and the default. `override_why`: the reason to log for an
    override the app made on its own (see settle_fallbacks)."""
    runnable = {n.lower() for n in runnable}
    present = {n.lower() for n in present}
    installed = set(installed)
    picks = set(picks)
    native = native or {}
    overrides = overrides or {}
    managed = set(auto) if managed is None else set(managed)
    native_choices = set(native_choices)
    suggested = {app: tool for app, tool in (suggested or {}).items() if isinstance(tool, str) and tool.lower() in runnable}
    new_tools = {app: tool for app, tool in (new_tools or {}).items() if isinstance(tool, str) and tool.lower() in runnable}
    override_why = override_why or {}
    changes, kept = {}, {}
    why = why if why is not None else {}

    def change(app, target, reason):
        changes[app] = target
        why[app] = reason

    if current.get("0", "") != default:
        change("0", default, why.get("0") or "the default stays %s" % default)
    for app in sorted((set(current) | installed | picks | set(auto) | set(overrides) | native_choices) - {"0"}, key=app_order):
        name = current.get(app, "")
        if app in overrides:
            target = overrides[app]
            if target is DEFERRED_GAME_TOOL:
                continue
            target = target or default
            if name != target:
                change(app, target, override_why.get(app) or
                       ("the app's per-game pick" if overrides[app] else "the app cleared its per-game pick"))
            if overrides[app] is None:
                kept[app] = target
            continue
        mine = auto.get(app)
        target = suggested[app] if app in suggested else new_tools[app] if app in new_tools else native.get(app, default)
        how = ("the known-games table suggests it" if app in suggested else
               "it is new here and starts on the pinned DroidDeck Proton" if app in new_tools else
               "its native build" if app in native else "it follows the default")
        if not name and app in native_choices:
            target = NATIVE_CHOICE
        stale = unrunnable(name, runnable | present)
        if name and not stale and (mine is None or name != mine):
            continue
        if target is NATIVE_CHOICE:
            if not name and (app in native_choices or app in current or app in managed):
                kept[app] = NATIVE_CHOICE
                continue
            target = default
        if target is None:
            if stale:
                target = default
                if name != target:
                    change(app, target, "%s is not runnable here" % name)
                continue
            else:
                if name and app in managed and name == mine:
                    change(app, None, "it returns to Steam's own default")
                continue
        if not name and app not in installed and app not in picks:
            continue
        if name != target:
            change(app, target, "%s is not runnable here" % name if stale else
                   how + (" (was %s)" % name if name else " (no tool yet)"))
        kept[app] = target
    return changes, kept


def picked_apps(state):
    picked = state.get("picked", ())
    return {app for app in picked if isinstance(app, str)} if isinstance(picked, list) else set()


def picked_after(current, changes):
    return sorted(({app for app, tool in current.items() if tool} - set(changes) |
                   {app for app, tool in changes.items() if tool}) - {"0"}, key=app_order)


def followers(state, current):
    if "auto" in state:
        return state["auto"]
    return {app: name for app, name in current.items() if app != "0" and name == TOOL}


def respect_enabled(environ=None):
    """DD_COMPAT_RESPECT (default on): a tool the player picked in the client survives restarts, and a title is
    not moved onto a tool its prefix cannot take. 0/off/false/no keeps the earlier planning."""
    value = (os.environ if environ is None else environ).get("DD_COMPAT_RESPECT", "1")
    return value.strip().lower() not in ("0", "off", "false", "no")


PICK_FRESH_MS = 10000


def settle_picks(state, current, claims=(), live=False, saved_at=None, now=None):
    """The player's own picks in the client ("0" is the general default). `claims`: (app, tool, at_ms) the
    client's UI sent, from the live helper; one counts once the client's mapping shows it. Returns
    (chosen, unresolved claims, restore, lines). `restore` (start-up only): picks the client has not
    saved to config.vdf yet (the file is older than the pick), which are put back. A pick the mapping no
    longer shows is dropped: what the client says now is the truth."""
    now = now or now_ms()
    raw = state.get("chosen")
    chosen = {a: dict(c) for a, c in raw.items() if isinstance(a, str) and isinstance(c, dict) and isinstance(c.get("name"), str)} \
        if isinstance(raw, dict) else {}
    lines, waiting, restore = [], [], {}
    for app, name, at in claims:
        if name == "":
            if chosen.pop(app, None) is not None:
                lines.append("%s: you cleared your pick" % ("default" if app == "0" else "app " + app))
        elif current.get(app) == name:
            chosen[app] = {"name": name, "at": at}
        elif now - at < PICK_FRESH_MS:
            waiting.append((app, name, at))
    for app, pick in sorted(chosen.items(), key=lambda item: app_order(item[0])):
        if current.get(app) == pick["name"]:
            continue
        if not live and saved_at is not None and saved_at < int(pick.get("at", 0) or 0):
            if app != "0":
                restore[app] = pick["name"]
            continue
        del chosen[app]
        lines.append("%s: forgot your pick %s (the client now has %s)" % (
            "default" if app == "0" else "app " + app, pick["name"], current.get(app) or "nothing"))
    return chosen, waiting, restore, lines


def pinned_apps(chosen, current):
    return {app for app, pick in chosen.items() if app != "0" and current.get(app) == pick["name"]}


# --- A title whose process tree ends within a minute without ever showing a frame (hotfix) ---------------
# Valve's "Proton Experimental (ARM64)" updates itself (BuildID 26306334 on 11-02) and several titles then died at
# the start (a player log/CKEX/FTZH). Two such starts in a row on it move that title, once, to the
# pinned DroidDeck-Proton; new titles start on DroidDeck-Proton. DD_PROTON_FALLBACK=off keeps the earlier behaviour.

START_FAIL_SECONDS = 60
START_FAIL_LIMIT = 2
GAME_LOG_TIME = r"\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\]"
GAME_LOG_ADD = re.compile(r"^" + GAME_LOG_TIME + r" AppID (\d+) adding PID (\d+) as a tracked process(?: \"(.*))?$")
GAME_LOG_DEL = re.compile(r"^" + GAME_LOG_TIME + r" AppID (\d+) no longer tracking PID (\d+), exit code (-?\d+)")
GAME_TOOL_DIR = re.compile(r"/compatibilitytools\.d/([^/']+)")
# A non-Steam shortcut is logged under its 64-bit game id (appid << 32 | 0x02000000); its command names the id the client's
# CompatToolMapping and the app's state use.
GAME_LAUNCH_APP = re.compile(r"\bSteamLaunch AppId=(\d+)")
# Steam also runs install scripts and redistributables under the game's AppId: those are not the game.
GAME_HELPER_RUN = re.compile(r"(?i)iscriptevaluator|installscript|vcredist|vc_redist|dxsetup|dxwebsetup|_commonredist|dotnetfx|oalinst|physx(?:legacy|_)")
FRAMES_LINE = re.compile(r"\bpid=(\d+) comm=(\S+) presents=(\d+)\b.*\bswapchains=(\d+) external=(\d+)")
# Wine's own helpers open a swapchain or two without the game having started drawing (explorer.exe in every run).
WINE_QUIET = frozenset(("explorer.exe", "services.exe", "winedevice.exe", "plugplay.exe", "svchost.exe", "rpcss.exe",
                        "wineboot.exe", "conhost.exe", "start.exe", "winedbg.exe", "tabtip.exe"))


def fallback_enabled(environ=None):
    """DD_PROTON_FALLBACK (default on): the start-failure guard and the DroidDeck-Proton start for new titles.
    0/off/false/no keeps the earlier behaviour."""
    value = (os.environ if environ is None else environ).get("DD_PROTON_FALLBACK", "1")
    return value.strip().lower() not in ("0", "off", "false", "no")


def new_title_mode(environ=None):
    """DD_NEW_TITLE_TOOL: "droiddeck" (default) starts a title that has no prefix yet on the pinned
    DroidDeck-Proton; "experimental" leaves it on the default (Valve's Proton Experimental ARM64)."""
    value = (os.environ if environ is None else environ).get("DD_NEW_TITLE_TOOL", "droiddeck").strip().lower()
    return "experimental" if value in ("experimental", "valve", "default", "old", "0", "off", "no") else "droiddeck"


def env_int(name, default, low, high, environ=None):
    try:
        value = int((os.environ if environ is None else environ).get(name, "").strip())
    except ValueError:
        return default
    return value if low <= value <= high else default


def log_time(text):
    import calendar
    import time
    return calendar.timegm(time.strptime(text, "%Y-%m-%d %H:%M:%S"))


class GameRunTracker:
    """Follows Steam's gameprocess_log.txt: a run begins at the line that adds the SteamLaunch process (its command
    names the compatibility tool) and ends at the line that removes that process. feed returns the runs that ended."""

    def __init__(self):
        self.open = {}

    def feed(self, text):
        done = []
        for line in text.splitlines():
            added = GAME_LOG_ADD.match(line)
            if added:
                when, app, pid, command = added.groups()
                if command is not None and "SteamLaunch" in command:
                    tool = GAME_TOOL_DIR.search(command)
                    title = GAME_LAUNCH_APP.search(command)
                    self.open[(app, int(pid))] = {
                        "app": title.group(1) if title else app, "logged": app, "pid": int(pid), "start": log_time(when), "end": None, "pids": {int(pid)},
                        "tool": tool.group(1) if tool else None, "helper": bool(GAME_HELPER_RUN.search(command)),
                        "waits": "waitforexitandrun" in command}
                else:
                    mine = [key for key in self.open if key[0] == app]
                    if mine:
                        self.open[max(mine, key=lambda key: self.open[key]["start"])]["pids"].add(int(pid))
                continue
            gone = GAME_LOG_DEL.match(line)
            if gone and (gone.group(2), int(gone.group(3))) in self.open:
                run = self.open.pop((gone.group(2), int(gone.group(3))))
                run["end"] = log_time(gone.group(1))
                run["code"] = int(gone.group(4))
                done.append(run)
        return done


class GameLogTail:
    """The new complete lines of a log file since the last read. The first read of a file that is already there
    starts at its end (an earlier session's runs have no frame counts left to judge them by)."""

    def __init__(self, path):
        self.path = path
        self.pos = None
        self.ino = None

    def read(self, limit=1 << 20):
        try:
            info = os.stat(self.path)
        except OSError:
            self.pos, self.ino = 0, None
            return ""
        if self.pos is None:
            self.pos, self.ino = info.st_size, info.st_ino
            return ""
        if info.st_ino != self.ino or info.st_size < self.pos:
            self.pos, self.ino = 0, info.st_ino
        if info.st_size == self.pos:
            return ""
        try:
            with open(self.path, "rb") as f:
                f.seek(self.pos)
                data = f.read(limit)
        except OSError:
            return ""
        end = data.rfind(b"\n") + 1
        self.pos += end
        return data[:end].decode("utf-8", "replace")


def frames_directory(environ=None):
    """The folder the bridge's clients write vkbridge-frames-<pid>.txt into (see external/MaliBridge/client/frames.c)."""
    env = os.environ if environ is None else environ
    if env.get("VKBRIDGE_FRAMES") == "0":
        return None
    if env.get("VKBRIDGE_FRAMES_DIR"):
        return env["VKBRIDGE_FRAMES_DIR"]
    log = env.get("VKBRIDGE_CLIENT_LOG")
    return os.path.dirname(log) if log and os.path.dirname(log) else None


def read_frames(directory):
    """pid -> (comm, presents, swapchains, external) from the frames files, or None without the folder."""
    if not directory:
        return None
    try:
        names = os.listdir(directory)
    except OSError:
        return None
    frames = {}
    for name in names:
        if not re.fullmatch(r"vkbridge-frames-\d+\.txt", name):
            continue
        try:
            with open(os.path.join(directory, name), encoding="utf-8", errors="replace") as f:
                found = FRAMES_LINE.search(f.read(4096))
        except OSError:
            continue
        if found:
            frames[int(found.group(1))] = (found.group(2), int(found.group(3)), int(found.group(4)), int(found.group(5)))
    return frames


def run_evidence(run, frames):
    """"presented" (a process of the run showed a frame), "gpu" (one reached the GPU path without a frame: Zink/OpenGL
    games pass theirs on as dma-bufs), "nothing", or "unknown" when this session counts no frames at all (no bridge)."""
    if not frames or not any(entry[1] > 0 for entry in frames.values()):
        return "unknown"
    mine = [frames[pid] for pid in run["pids"] if pid in frames]
    if any(entry[1] > 0 for entry in mine):
        return "presented"
    if any(entry[0] not in WINE_QUIET and (entry[2] > 0 or entry[3] > 0) for entry in mine):
        return "gpu"
    return "nothing"


def start_run_outcome(state, run, evidence, seconds=START_FAIL_SECONDS, now=None):
    """Counts a finished run in state["start_runs"] {app: {tool dir: {"fails", "last"}}}. A run that showed a frame (or reached the
    GPU path) resets the title's count on that tool. Returns "fail", "ok" or "ignored"."""
    app, tool = run["app"], run["tool"]
    counts = state.get("start_runs") if isinstance(state.get("start_runs"), dict) else {}
    state["start_runs"] = counts
    per = counts.get(app) if isinstance(counts.get(app), dict) else {}
    counts[app] = per
    life = run["end"] - run["start"]
    if evidence in ("presented", "gpu"):
        per.pop(tool, None)
        waiting = state.get("pending_fallbacks")
        if isinstance(waiting, dict) and tool == TOOL and waiting.pop(app, None) is not None and not waiting:
            state.pop("pending_fallbacks", None)
        kind = "ok"
    elif evidence == "nothing" and life <= seconds:
        before = per.get(tool) if isinstance(per.get(tool), dict) else {}
        per[tool] = {"fails": int(before.get("fails", 0) or 0) + 1, "last": now or now_ms()}
        kind = "fail"
    else:
        kind = "ignored"
    if not per:
        counts.pop(app, None)
    return kind


def start_fail_count(state, app, tool):
    """The title's count of starts in a row on `tool` that showed no frame (state["start_runs"])."""
    counts = state.get("start_runs") if isinstance(state.get("start_runs"), dict) else {}
    per = counts.get(app) if isinstance(counts.get(app), dict) else {}
    entry = per.get(tool) if isinstance(per.get(tool), dict) else {}
    return int(entry.get("fails", 0) or 0)


def counts_as_run(run):
    """Only a Proton launch of a title counts: not a native game, an install script or a redistributable."""
    return bool(run.get("tool")) and run.get("waits") and not run.get("helper") and run.get("end") is not None


def app_title(steam_root, app):
    tokens = app_manifest(steam_root, app)
    for i in range(len(tokens or []) - 1):
        if tokens[i].lower() == '"name"':
            return tokens[i + 1].strip('"')
    return shortcut_name(steam_root, app) or app


def shortcut_name(steam_root, app):
    """The name of a non-Steam shortcut (the client's shortcuts.vdf, or the app's added games in $BL_ADDED_GAMES), or None."""
    if not str(app).isdecimal() or int(app) < 2 ** 31:
        return None
    want = int(app) & 0xFFFFFFFF
    try:
        with open(os.environ.get("BL_ADDED_GAMES", ""), encoding="utf-8") as f:
            for game in json.load(f):
                if isinstance(game, dict) and str(game.get("appid", "")).isdecimal() and int(game["appid"]) & 0xFFFFFFFF == want \
                        and isinstance(game.get("name"), str) and game["name"]:
                    return game["name"]
    except (OSError, ValueError, TypeError):
        pass
    try:
        tool = runpy.run_path(os.path.join(os.path.dirname(os.path.abspath(__file__)), "droiddeck-steam-shortcuts"))
        account = tool["account_dir"](steam_root)
        with open(os.path.join(account, "config", "shortcuts.vdf"), "rb") as f:
            entries = tool["parse"](f.read()).get("shortcuts", {})
        for entry in entries.values():
            if isinstance(entry, dict) and isinstance(entry.get("appid", entry.get("AppId")), int) \
                    and entry.get("appid", entry.get("AppId")) & 0xFFFFFFFF == want:
                name = entry.get("AppName", entry.get("appname"))
                return name if isinstance(name, str) and name else None
    except Exception:
        pass
    return None


def newest_own_proton(catalog, only=None, environ=None):
    """Name of the DroidDeck-Proton build the app starts titles on (limited to the names in `only`), or None: the
    validated build installed first in the preference order (see validated_own_order: the default first), else the newest installed one.
    A build that appears upstream is never preferred over a validated one that is installed."""
    builds = [t for t in own_builds(catalog) if only is None or t["name"] in only]
    best = preferred_own_build(builds, environ)
    return best["name"] if best else None


def prefix_exists(steam_root, app):
    names = [app]
    if str(app).isdecimal() and int(app) >= 2 ** 31:
        names.append(str(int(app) - 2 ** 32))  # a shortcut's prefix can carry the signed spelling of its id
    return any(os.path.isdir(os.path.join(library, "steamapps", "compatdata", name))
               for library in libraries(steam_root) for name in names)


def pick_owner(state, app, requests=(), chosen=None):
    """Who decided the tool of `app`, as far as the guard needs to know: "moved" (the app moved it before), "picked" (the player:
    a pick recorded from the client's UI in state "chosen", a per-game pick in the app, or, for a title nobody recorded, a tool
    other than the general default) or None (it follows the app's planning).
    Not evidence of a pick: state "picked" (every title the client has a tool for, whoever set it: it only drives the native-build
    handling), the priority in config.vdf (the app writes 250 as the client does for a player's pick), and Valve's own mappings
    (the client keeps them in memory at priority 75-101, they are not in config.vdf). A mapping that nobody recorded and that
    equals the general default (the app's own Experimental) says nothing about a choice: the title follows the default."""
    auto = state.get("auto") if isinstance(state.get("auto"), dict) else {}
    records = state.get("fallbacks") if isinstance(state.get("fallbacks"), dict) else {}
    chosen = chosen if chosen is not None else (state.get("chosen") if isinstance(state.get("chosen"), dict) else {})
    if app in records:
        return "moved"
    if app in chosen or app in requests:
        return "picked"
    mine = auto.get(app)
    if mine == TOOL:
        return None
    if mine is None and state.get("default", TOOL) != TOOL:
        return "picked"
    return None if mine is None else "other"


def fallback_candidate(state, app, requests=(), chosen=None):
    """Whether the app may move `app` off Proton Experimental: nobody picked its tool (in Steam: state "chosen"; in the app:
    games.json; see pick_owner) and it has not been moved before."""
    return pick_owner(state, app, requests, chosen) is None


def make_fallback(state, steam_root, app, target, fails, reason=None, now=None):
    """Stores the move of `app` to `target` in state["fallbacks"] and takes the title out of the followers (state["auto"]),
    so that no planner moves it back. Returns the record."""
    record = {"title": app_title(steam_root, app), "from": TOOL, "to": target, "fails": fails, "at": now or now_ms(), "confirmed": False,
              "reason": reason or "it closed before showing anything on Proton Experimental %d times in a row" % fails}
    state.setdefault("fallbacks", {})[app] = record
    if isinstance(state.get("auto"), dict):
        state["auto"].pop(app, None)
    per = state.get("start_runs", {}).get(app, {})
    per.pop(TOOL, None)
    if not per:
        state.get("start_runs", {}).pop(app, None)
    return record


def remember_pick_notice(state, app, tool):
    """The player was told that `app` closed twice on `tool`, a tool they picked: not again for that title and tool."""
    told = state.get("pick_notices") if isinstance(state.get("pick_notices"), dict) else {}
    state["pick_notices"] = told
    tools = told.get(app) if isinstance(told.get(app), list) else []
    if tool not in tools:
        tools.append(tool)
    told[app] = tools


def decide_fallback(state, steam_root, app, run_tool, requests=(), catalog=None, limit=START_FAIL_LIMIT, now=None):
    """After a counted failure: ("switch", record), ("missing", record) when the title qualifies but no DroidDeck-Proton is
    installed (the move is then kept in state["pending_fallbacks"], see settle_pending_fallbacks), ("picked", info) when the player
    picked the tool of the title (nothing is moved; the caller tells the player once, see remember_pick_notice), or (None, why). On "switch"
    the record is stored in state["fallbacks"] and the title leaves state["auto"] (it is not a follower any more, so no
    planner moves it back)."""
    if run_tool != TOOL:
        return None, "not on Proton Experimental"
    per = state.get("start_runs", {}).get(app, {}).get(TOOL, {})
    fails = int(per.get("fails", 0) or 0)
    if fails < limit:
        return None, "%d of %d" % (fails, limit)
    owner = pick_owner(state, app, requests)
    if owner == "picked":
        # The player's choice wins: nothing is moved, but they are told once per title and tool (state["pick_notices"]).
        told = state.get("pick_notices") if isinstance(state.get("pick_notices"), dict) else {}
        if run_tool in (told.get(app) if isinstance(told.get(app), list) else []):
            return None, "the player was told already"
        return "picked", {"title": app_title(steam_root, app), "tool": run_tool, "fails": fails}
    if owner is not None:
        return None, "the tool of this title was moved before, or follows another tool"
    catalog = catalog if catalog is not None else tool_catalog(steam_root)
    target = newest_own_proton(catalog)
    if target is None:
        waiting = state.get("pending_fallbacks") if isinstance(state.get("pending_fallbacks"), dict) else {}
        state["pending_fallbacks"] = waiting
        record = waiting.get(app) if isinstance(waiting.get(app), dict) else {
            "title": app_title(steam_root, app), "from": TOOL, "at": now or now_ms(),
            "reason": "it closed before showing anything on Proton Experimental %d times in a row" % fails}
        record["fails"] = fails
        waiting[app] = record
        return "missing", record
    return "switch", make_fallback(state, steam_root, app, target, fails, now=now)


def settle_pending_fallbacks(state, steam_root, catalog, runnable, overrides, chosen, lines, now=None):
    """A move waiting for a DroidDeck-Proton (state["pending_fallbacks"]) becomes the normal move (state["fallbacks"], made by
    settle_fallbacks) once one is installed and listed. It is made exactly once: the waiting record goes in that step. It is
    dropped, without anything done, when the player picked a tool for the title meanwhile (in Steam or in the app), when the
    title does not follow the app's planning any more, or when it ran well on Proton Experimental again."""
    waiting = state.get("pending_fallbacks")
    if not fallback_enabled() or not isinstance(waiting, dict):
        return
    target = newest_own_proton(catalog, set(runnable))
    records = state.get("fallbacks") if isinstance(state.get("fallbacks"), dict) else {}
    for app, record in sorted(waiting.items(), key=lambda item: app_order(item[0])):
        label = "app %s (%s)" % (app, (record.get("title") if isinstance(record, dict) else None) or app)
        if not isinstance(record, dict) or app in records:
            del waiting[app]
            continue
        pick = chosen.get(app)
        if pick and int(pick.get("at", 0) or 0) > int(record.get("at", 0) or 0):
            del waiting[app]
            lines.append("%s: you picked %s; the waiting move to DroidDeck-Proton is dropped" % (label, pick["name"]))
        elif app in overrides or not fallback_candidate(state, app, overrides, chosen):
            del waiting[app]
            lines.append("%s: a tool was picked for it meanwhile; the waiting move to DroidDeck-Proton is dropped" % label)
        elif target is not None:
            del waiting[app]
            make_fallback(state, steam_root, app, target, int(record.get("fails", 0) or 0), record.get("reason"), now)
            lines.append("%s: DroidDeck-Proton is installed now; the move to %s that was waiting for it is made" % (label, target))
    if not waiting:
        state.pop("pending_fallbacks", None)


def settle_fallbacks(state, current, overrides, chosen, disk, live, why, lines):
    """The tool moves the app decided on (state["fallbacks"]) that still have to be made: {app: tool}. A decision ends,
    without anything being undone, when the player picks a tool for the title (in Steam after it, or in the app), when its
    tool is gone, or when the client shows another tool than the one it was moved to once that was confirmed (the
    player or Steam changed it: the player's pick wins and the title is never moved back)."""
    records = state.get("fallbacks")
    if not fallback_enabled() or not isinstance(records, dict):
        return {}
    moves = {}
    for app, record in sorted(records.items(), key=lambda item: app_order(item[0])):
        if not (isinstance(record, dict) and isinstance(record.get("to"), str) and isinstance(record.get("from"), str)):
            del records[app]
            continue
        label = "app %s (%s)" % (app, record.get("title") or app)
        pick = chosen.get(app)
        now_on = current.get(app, "")
        if pick and int(pick.get("at", 0) or 0) > int(record.get("at", 0) or 0):
            del records[app]
            lines.append("%s: you picked %s after MaliBridge moved it off %s; your pick stays" % (label, pick["name"], record["from"]))
        elif app in overrides:
            del records[app]
            lines.append("%s: a tool picked in the app decides now; MaliBridge's move off %s is dropped" % (label, record["from"]))
        elif record["to"] not in disk:
            del records[app]
            lines.append("%s: %s is not installed any more; MaliBridge's move off %s is dropped" % (label, record["to"], record["from"]))
        elif now_on == record["to"]:
            record["confirmed"] = True
        elif record.get("confirmed"):
            del records[app]
            lines.append("%s: now on %s (changed after MaliBridge moved it to %s); left alone" % (label, now_on or "Steam's default", record["to"]))
        elif now_on in ("", record["from"]):
            if record["to"] in live:
                moves[app] = record["to"]
                why[app] = "MaliBridge moved it: %s" % record.get("reason", "it could not start")
        else:
            del records[app]
            lines.append("%s: on %s before the move to %s was made; left alone" % (label, now_on, record["to"]))
    return moves


def new_title_apps(steam_root, state, apps, default, chosen, native, requests=(), environ=None):
    """The titles that start on the newest DroidDeck-Proton instead of Valve's auto-updating Proton Experimental: no prefix
    yet, not native, nobody picked their tool, and only while the default is still the app's own Experimental (nobody picked
    another general default)."""
    if not fallback_enabled(environ) or new_title_mode(environ) != "droiddeck":
        return []
    if default != TOOL or "0" in chosen or state.get("source") in ("steam", "app"):
        return []
    records = state.get("fallbacks") if isinstance(state.get("fallbacks"), dict) else {}
    return [app for app in apps if app != "0" and app.isdecimal() and app not in native and app not in chosen and
            app not in requests and app not in records and not prefix_exists(steam_root, app)]


def new_title_tools(steam_root, state, apps, catalog, runnable, default, chosen, native, requests=(), environ=None):
    """{app: tool}: titles with no prefix yet start on the newest DroidDeck-Proton (a pinned build) instead of Valve's
    auto-updating Proton Experimental (see new_title_apps), and only when a DroidDeck-Proton is installed.
    A title that has a prefix keeps its tool: no prefix-family change for a game that works."""
    if not own_default_enabled(environ):
        return {}
    target = newest_own_proton(catalog, set(runnable), environ)
    if target is None:
        return {}
    return {app: target for app in new_title_apps(steam_root, state, apps, default, chosen, native, requests, environ)}


def remember_new_title_tools(state, new_tools, allowed, auto):
    """A title that took the new-title tool is the app's decision from then on: it leaves the followers (state["auto"])
    so that nothing moves it to the default once its prefix exists, and the record says where it came from."""
    for app, tool in allowed.items():
        if new_tools.get(app) == tool:
            auto.pop(app, None)
            state.setdefault("new_title_tools", {})[app] = tool


# --- Launches without the Steam client (droiddeck-proton-run --app: a non-Steam shortcut or a game the app added, started without
# Steam) --- The guard above reads Steam's game log, which such a launch never writes, and the new-title default above is written
# into config.vdf only at a Steam session's start; droiddeck-proton-run asks these two instead.

FRAMES_LAST = re.compile(r"\bt_last=([0-9.]+)")
# The session's own processes: they draw before and after the game, so they say nothing about it.
SESSION_COMMS = frozenset(("gamescope", "gamescope-wl", "Xwayland", "droiddeck-vkbri", "vulkaninfo", "steam", "steamwebhelper",
                           "gldriverquery", "vulkandriverque", "steamsysinfo"))
NEW_TITLE_REASON = "a new title starts on the pinned DroidDeck-Proton"


def launch_evidence(directory, start_mono, start_wall):
    """How a launch that has the session to itself ended, from the frames files: "presented" (a process other than the session's
    own showed a frame after the launch: CLOCK_MONOTONIC t_last, the clock the bridge's clients write), "gpu" (one reached the GPU
    path after it without a frame), "nothing", or "unknown" (no frames file at all: no bridge, or VKBRIDGE_FRAMES=0)."""
    if not directory:
        return "unknown"
    try:
        names = os.listdir(directory)
    except OSError:
        return "unknown"
    seen, gpu = False, False
    for name in names:
        if not re.fullmatch(r"vkbridge-frames-\d+\.txt", name):
            continue
        path = os.path.join(directory, name)
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                text = f.read(4096)
            changed = os.stat(path).st_mtime
        except OSError:
            continue
        found = FRAMES_LINE.search(text)
        if not found:
            continue
        seen = True
        comm, presents, swapchains, external = found.group(2), int(found.group(3)), int(found.group(4)), int(found.group(5))
        if comm in SESSION_COMMS:
            continue
        last = FRAMES_LAST.search(text)
        if presents > 0 and last and float(last.group(1)) >= start_mono:
            return "presented"
        if comm not in WINE_QUIET and (swapchains > 0 or external > 0) and changed >= start_wall:
            gpu = True
    if not seen:
        return "unknown"
    return "gpu" if gpu else "nothing"


def launch_tool(state, steam_root, app, current, available, requests=(), catalog=None, environ=None, now=None):
    """(tool, why) for a launch without the Steam client when the app's planning decides instead of the client's mapping, else
    (None, None). Two cases: the app moved the title (state["fallbacks"]) and the client has not run since to write it into
    config.vdf; or the title has no prefix yet and follows the app's Proton Experimental default, so it starts on the newest
    DroidDeck-Proton, as new_title_tools does for Steam's titles (recorded as a move, so the next Steam session writes it into
    config.vdf too and Steam starts it on the same tool). The player's pick always wins: a tool picked in Steam (state "chosen",
    or a mapping the app did not make), a per-game pick in the app (games.json), or another general default."""
    if not fallback_enabled(environ):
        return None, None
    chosen = state.get("chosen") if isinstance(state.get("chosen"), dict) else {}
    records = state.get("fallbacks") if isinstance(state.get("fallbacks"), dict) else {}
    mine = current.get(app) or None
    record = records.get(app)
    if isinstance(record, dict) and app not in requests:
        pick = chosen.get(app)
        newer_pick = isinstance(pick, dict) and int(pick.get("at", 0) or 0) > int(record.get("at", 0) or 0)
        if record.get("to") in available and not newer_pick and mine in (None, record.get("from"), record.get("to")):
            return record["to"], "MaliBridge moved it: %s" % record.get("reason", "it could not start")
        return None, None
    if app in requests or app in chosen:
        return None, None
    if mine is not None and not (mine == TOOL and pick_owner(state, app, requests, chosen) is None):
        return None, None
    default = current.get("0") or state.get("default") or TOOL
    if not new_title_apps(steam_root, state, [app], default, chosen, (), requests, environ):
        return None, None
    catalog = catalog if catalog is not None else tool_catalog(steam_root)
    target = newest_own_proton(catalog, set(available), environ)
    if target is None:
        return None, None
    make_fallback(state, steam_root, app, target, 0, reason=NEW_TITLE_REASON, now=now)
    state.setdefault("new_title_tools", {})[app] = target
    return target, NEW_TITLE_REASON


def judge_launch(state, steam_root, app, tool, start, end, evidence, requests=(), seconds=START_FAIL_SECONDS,
                 limit=START_FAIL_LIMIT, now=None):
    """Counts a launch without the Steam client like the guard counts a Steam run (start_run_outcome) and decides on a move
    (decide_fallback). `tool` is the tool's folder name (droiddeck-proton-arm64 for Valve's Proton Experimental). Returns
    (kind, decision, record)."""
    run = {"app": app, "tool": tool, "start": start, "end": end, "pids": set()}
    kind = start_run_outcome(state, run, evidence, seconds, now)
    decision, record = None, None
    if kind == "fail":
        decision, record = decide_fallback(state, steam_root, app, tool, requests, limit=limit, now=now)
    return kind, decision, record


# Exit-at-start diagnostics: a title whose start the guard counts as a failure (start_run_outcome "fail": closed within
# START_FAIL_SECONDS without any of its processes showing a frame; a player log Little Nightmares, 6 s, no Proton log) gets a flag
# file <COMPAT_DIR>/exit-diag/<app>. droiddeck-game-env renames it to <app>.used at that title's next launch and turns on
# Proton's log, DXVK at info and vkd3d warnings for that launch only, into the session's log folder, so the next Send logs
# holds why it closed. While <app> or <app>.used exists nothing is armed again (one diagnostic launch per failure streak);
# a run that shows frames clears both. DD_EXIT_DIAG=0 turns it off. Launches of titles that run never see any of this.
EXIT_DIAG_DIR = "exit-diag"


def exit_diag_enabled(environ=None):
    value = (os.environ if environ is None else environ).get("DD_EXIT_DIAG", "1")
    return value.strip().lower() not in ("0", "off", "false", "no")


def arm_exit_diag(app, directory=None):
    """Arms one diagnostic launch for `app`; False when it is off, already armed or already used in this failure streak."""
    if not exit_diag_enabled() or not re.fullmatch(r"[0-9]+", str(app)):
        return False
    folder = os.path.join(directory or COMPAT_DIR, EXIT_DIAG_DIR)
    flag = os.path.join(folder, str(app))
    if os.path.exists(flag) or os.path.exists(flag + ".used"):
        return False
    try:
        os.makedirs(folder, exist_ok=True)
        with open(flag + ".tmp", "w", encoding="utf-8") as f:
            f.write("%d\n" % now_ms())
        os.replace(flag + ".tmp", flag)
    except OSError:
        return False
    return True


def clear_exit_diag(app, directory=None):
    """A run of `app` showed frames: its flag and its used mark go, so a later failure gets a diagnostic launch again."""
    flag = os.path.join(directory or COMPAT_DIR, EXIT_DIAG_DIR, str(app))
    for path in (flag, flag + ".used"):
        try:
            os.unlink(path)
        except OSError:
            pass


EXIT_DIAG_SAID = ("its next start writes Proton's log (PROTON_LOG=1, DXVK info, vkd3d warnings) for that launch only, so Send "
                  "logs after it shows why it closed (DD_EXIT_DIAG=0 turns this off)")


def write_notice(kind, app, title, tool, directory=None, reason="", replace=True):
    """The note for the app: $BL_LAUNCH_DIR/compat-notice, replaced atomically. kind "switched" (a Toast: the title was moved
    to `tool`), "picked" (a Toast: the title closed twice on `tool`, which the player picked, so it was left alone) or "install" (the app needs a DroidDeck-Proton and none is installed: reason "failed" for a title that closed
    twice before showing anything, "new" for titles that would start on one). The app decides whether to queue the download
    (ProtonExtras, .bl-proton-extra) or to ask the player, because only it knows whether the player declined it and what the
    network is. With replace=False an unread note is left alone (False is returned)."""
    directory = directory or os.environ.get("BL_LAUNCH_DIR")
    if not directory or not os.path.isdir(directory):
        return False
    path = os.path.join(directory, "compat-notice")
    if not replace and os.path.exists(path):
        return False
    note = {"kind": kind, "app": app, "title": title, "from": "Proton Experimental", "to": tool}
    if reason:
        note["reason"] = reason
    try:
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            f.write(json.dumps(note) + "\n")
        os.replace(path + ".tmp", path)
    except OSError:
        return False
    return True


PREFIX_VERSION_RE = re.compile(r"^\s*CURRENT_PREFIX_VERSION\s*=\s*[\"']([^\"']+)[\"']", re.M)


def prefix_version(steam_root, app):
    """What the version file of the title's prefix says (the Proton that last used it), or None."""
    for library in libraries(steam_root):
        try:
            with open(os.path.join(library, "steamapps", "compatdata", app, "version"), encoding="utf-8", errors="replace") as f:
                text = f.readline().strip()
        except OSError:
            continue
        if text:
            return text
    return None


def tool_prefix_version(steam_root, tool, cache=None):
    """The prefix version a Proton writes (CURRENT_PREFIX_VERSION in its proton script), or None."""
    if not tool or not tool.get("dir"):
        return None
    key = (tool["dir"], bool(tool.get("valve")))
    if cache is not None and key in cache:
        return cache[key]
    found = _tool_prefix_version(steam_root, tool)
    if cache is not None:
        cache[key] = found
    return found


def _tool_prefix_version(steam_root, tool):
    if tool.get("valve"):
        bases = [os.path.join(library, "steamapps", "common", tool["dir"]) for library in libraries(steam_root)]
    else:
        bases = [os.path.join(steam_root, "compatibilitytools.d", tool["dir"])]
    for base in bases:
        try:
            with open(os.path.join(base, "proton"), encoding="utf-8", errors="replace") as f:
                found = PREFIX_VERSION_RE.search(f.read())
        except OSError:
            continue
        if found:
            return found.group(1)
    return None


def prefix_family(version):
    """Proton reads an earlier prefix version only as <version>-<number> (Valve's "11.0-100"); a GE-style
    "GE-Proton11-11" is another family, and either way round it calls the prefix invalid."""
    parts = version.split("-")
    return "valve" if len(parts) == 2 and re.fullmatch(r"[0-9][0-9A-Za-z.]*", parts[0]) and parts[1].isdigit() else "ge"


def prefix_risk(prefix, tool):
    """None, "family" (the prefix and the tool are from different Proton families, in either direction)
    or "newer" (the prefix was made by a newer Proton of the same family than the tool)."""
    if not prefix or not tool or prefix == tool:
        return None
    if prefix_family(prefix) != prefix_family(tool):
        return "family"
    numbers = lambda v: [int(n) for n in re.findall(r"\d+", v)]
    return "newer" if numbers(prefix) > numbers(tool) else None


def prefix_message(app, prefix, tool_name, tool, risk):
    kinds = {"valve": "Valve's Proton", "ge": "a GE-based Proton (DroidDeck-Proton)"}
    return ("app %s: its prefix was made by %s %s, but it runs on %s (%s). " % (
        app, kinds[prefix_family(prefix)], prefix, tool_name, tool) +
        ("Proton calls a prefix from the other family invalid ('Prefix has an invalid version') and the game can die a second after it starts. "
         if risk == "family" else
         "Proton does not take a prefix made by a newer build and the game can die a second after it starts. ") +
        "Switching a game back and forth between tools breaks its prefix: pick one tool for it and keep it. The prefix is not deleted.")


def guard_prefixes(steam_root, changes, why, current, catalog, runnable, overrides, present=(), hold=True, cache=None):
    """Splits `changes` into those to make and those to hold back (app -> the tool it keeps). A change
    nobody asked for (follows the default, a stale tool, a suggestion) that would put a title on a tool its
    prefix cannot take is held back while the tool it has still runs; the app's own per-game pick is made
    (the player asked), and so is a change the title needs to run at all."""
    by_name = {t["name"]: t for t in catalog}
    runs = {n.lower() for n in runnable} | {n.lower() for n in present}
    allowed, held = {}, {}
    for app, tool in changes.items():
        entry = by_name.get(tool) if tool else None
        risk = None
        if app != "0" and entry is not None:
            risk = prefix_risk(prefix_version(steam_root, app), tool_prefix_version(steam_root, entry, cache))
        name = current.get(app, "")
        implicit = app != "0" and not name
        if implicit:
            name = current.get("0", "") if "0" in changes else ""
        if hold and risk and app not in overrides and name and not unrunnable(name, runs):
            held[app] = name
            if implicit:
                allowed[app] = name  # it ran on the old general default: pin it there, or it moves with "0"
        else:
            allowed[app] = tool
    return allowed, held


def prefix_warnings(steam_root, effective, catalog, cache=None):
    """App id -> plain-language warning, for every title whose prefix its tool (after this run) cannot take."""
    by_name = {t["name"]: t for t in catalog}
    out = {}
    for app, name in sorted(effective.items(), key=lambda item: app_order(item[0])):
        entry = by_name.get(name)
        if app == "0" or entry is None:
            continue
        prefix, tool = prefix_version(steam_root, app), tool_prefix_version(steam_root, entry, cache)
        risk = prefix_risk(prefix, tool)
        if risk:
            out[app] = prefix_message(app, prefix, name, tool, risk)
    return out


def valve_build_changes(steam_root, state):
    """Valve's own tools (Proton Experimental ARM64, FEX, the runtimes) update on their own: remember the
    BuildID of each, and return a line for every one that moved since the last run."""
    builds = state.get("valve_builds") if isinstance(state.get("valve_builds"), dict) else {}
    seen, lines = dict(builds), []
    for app in REQUIRED_TOOLS:
        for library in libraries(steam_root):
            try:
                with open(os.path.join(library, "steamapps", "appmanifest_%s.acf" % app), encoding="utf-8", errors="replace") as f:
                    found = re.search(r'"buildid"\s+"(\d+)"', f.read())
            except OSError:
                continue
            if found:
                if app in builds and builds[app] != found.group(1):
                    lines.append("Valve updated tool %s%s: BuildID %s -> %s" % (
                        app, " (Proton Experimental ARM64, droiddeck-proton-arm64)" if app == PROTON_ARM64_APPID else "", builds[app], found.group(1)))
                seen[app] = found.group(1)
                break
    state["valve_builds"] = seen
    return lines


def tool_entry(name, display, path, valve):
    return {"name": name, "display": display, "dir": os.path.basename(path) if path else "", "valve": valve}


def tool_catalog(steam_root, extras=None):
    tools = os.path.join(steam_root, "compatibilitytools.d")
    catalog = []
    for name, sources in OWN_TOOLS:
        depot = find_source(steam_root, sources)
        if depot is None and name != TOOL:
            continue
        catalog.append(tool_entry(name, display_name(
            os.path.basename(depot).replace(" (ARM64)", " ARM64") if depot else "Proton ARM64"), depot, True))
    if extras is None:
        extras = {}
        try:
            entries = sorted(os.listdir(tools))
        except OSError:
            entries = []
        for entry in entries:
            tool_dir = os.path.join(tools, entry)
            if entry in dict(OWN_TOOLS) or not any(os.path.isfile(os.path.join(tool_dir, w)) for w in (EXTRA_WRAPPER, LEGACY_EXTRA_WRAPPER)):
                continue
            extras[first_key(os.path.join(tool_dir, "compatibilitytool.vdf"), ["compatibilitytools", "compat_tools"]) or entry] = entry
    for name, entry in sorted(extras.items()):
        catalog.append(tool_entry(name, display_name(entry), os.path.join(tools, entry), False))
    return catalog


def requested_tool(request, catalog):
    name = request.get("name")
    if isinstance(name, str) and any(t["name"] == name for t in catalog):
        return name
    for tool in catalog:
        if tool["dir"] and tool["dir"] == request.get("dir") and tool["valve"] == bool(request.get("valve")):
            return tool["name"]
    return None


def game_requests(directory=None):
    return read_game_requests(directory)[0]


def read_game_requests(directory=None):
    try:
        with open(state_path("games.json", directory), encoding="utf-8") as f:
            text = f.read()
        value = json.loads(text)
    except (OSError, ValueError):
        return {}, None
    if not isinstance(value, dict) or value.get("version") != 1 or not isinstance(value.get("games"), dict):
        return {}, text
    return value["games"], text


def write_game_requests(requests, original, directory=None):
    path = state_path("games.json", directory)
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() != original:
                return False
    except OSError:
        if original is not None:
            return False
    return write_json(path, {"version": 1, "games": requests})


def valid_game_request(app, request):
    return (isinstance(app, str) and re.fullmatch(r"[1-9][0-9]*", app) is not None and int(app) <= 0xFFFFFFFF and
            (request is None or isinstance(request, dict) and isinstance(request.get("dir"), str) and
             request["dir"] != "" and isinstance(request.get("valve"), bool)))


def settle_game_requests(requests, state, current, catalog, missing_is_cleared=False):
    recorded = state.get("games_applied")
    if isinstance(recorded, dict):
        applied = dict(recorded)
    else:
        applied = dict(requests) if "tools" in state else {}
    by_name = {t["name"]: t for t in catalog}
    out = dict(requests)
    for app, request in requests.items():
        if not valid_game_request(app, request) or app not in applied or applied[app] != request:
            continue
        if request is None:
            del out[app]
            continue
        wanted = requested_tool(request, catalog)
        if wanted is None:
            continue
        if app in current:
            picked = current[app]
        elif missing_is_cleared:
            picked = ""
        else:
            continue
        if picked == wanted:
            continue
        tool = by_name.get(picked)
        if tool and tool["dir"]:
            out[app] = {"valve": tool["valve"], "dir": tool["dir"]}
        else:
            del out[app]
    return out, out != requests


def settled_game_requests(state, current, catalog, missing_is_cleared=False, directory=None):
    for _ in range(2):
        requests, text = read_game_requests(directory)
        settled, moved = settle_game_requests(requests, state, current, catalog, missing_is_cleared)
        if not moved or write_game_requests(settled, text, directory):
            return settled
    return None


def applied_game_requests(requests, overrides, state):
    recorded = state.get("games_applied")
    before = recorded if isinstance(recorded, dict) else {}
    if requests is None:
        return dict(before)
    return {app: request if app in overrides and overrides[app] is not DEFERRED_GAME_TOOL else before[app]
            for app, request in requests.items()
            if app in overrides and overrides[app] is not DEFERRED_GAME_TOOL or app in before}


def requested_games(requests, catalog, runnable=None):
    """App id -> requested tool, None for inherit, or DEFERRED_GAME_TOOL while unavailable."""
    runnable = None if runnable is None else set(runnable)
    resolved = {}
    for app, request in requests.items():
        if not isinstance(app, str) or not re.fullmatch(r"[1-9][0-9]*", app) or int(app) > 0xFFFFFFFF:
            continue
        if request is None:
            resolved[app] = None
            continue
        if (not isinstance(request, dict) or not isinstance(request.get("dir"), str) or
                not request["dir"] or not isinstance(request.get("valve"), bool)):
            continue
        tool = requested_tool(request, catalog)
        if tool is None or runnable is not None and tool not in runnable:
            resolved[app] = DEFERRED_GAME_TOOL
        else:
            resolved[app] = tool
    return resolved


OWN_PROTON = "DroidDeck-Proton"
ARCH_WORDS = re.compile(r"(?i)aarch64|arm64|x86_64|x86-64|amd64")


def own_builds(tools):
    return [t for t in tools if isinstance(t, dict) and not t.get("valve") and
            isinstance(t.get("dir"), str) and t["dir"].startswith(OWN_PROTON) and t.get("name")]


def build_key(name):
    return [int(n) for n in re.findall(r"\d+", ARCH_WORDS.sub(" ", name))]


# The DroidDeck-Proton builds MaliBridge tested on Mali. A build that is not here is never downloaded, made the default or
# given to a new title by the app on its own; a game already on it keeps it, and the player can still pick it. The app writes
# its list (ProtonExtras.VALIDATED_OWN) to VALIDATED_FILE at every session start; this copy is used when that file is missing
# and must stay the same (tools/tests/test_proton_pin.py checks it). In preference order: the first is the default the app
# starts new titles and moves titles on (release prep T11, owner 11-04: the build our tablets ran), the others are validated
# and kept when a title is on them. 11-11.10: tested on the Tab S11 Ultra (11-04). 11-11.11:
# 11-11.10 plus one 32-bit loader fix, same GE-Proton11-11 base and prefix version; player logs on Mali run games on it
#. 11-12.1 (11-03) is NOT here: new GE base, new Wine, DXVK 3.1.1-174, a new prefix version,
# tested by its author on Adreno only, and the first player who got it lost most of his games (11-04).
VALIDATED_OWN_BUILDS = ("DroidDeck-Proton-11-11.10", "DroidDeck-Proton-11-11.11")
VALIDATED_FILE = "/etc/droiddeck/proton-validated"


def pin_enabled(environ=None):
    """DD_PROTON_PIN (default on): the app starts and moves titles only onto validated DroidDeck-Proton builds.
    0/off/false/no: the newest installed build, as before."""
    value = (os.environ if environ is None else environ).get("DD_PROTON_PIN", "1")
    return value.strip().lower() not in ("0", "off", "false", "no")


def validated_own_order(environ=None, path=None):
    """The version keys (see build_key) of the validated DroidDeck-Proton builds in preference order, or None when the pin is off."""
    if not pin_enabled(environ):
        return None
    names = None
    try:
        with open(path or (os.environ if environ is None else environ).get("DD_PROTON_VALIDATED_FILE") or VALIDATED_FILE,
                  encoding="utf-8", errors="replace") as f:
            names = [line.strip() for line in f if line.strip() and not line.lstrip().startswith("#")]
    except OSError:
        pass
    order = []
    for n in names or VALIDATED_OWN_BUILDS:
        key = tuple(build_key(n))
        if key and key not in order:
            order.append(key)
    return order


def validated_own_builds(environ=None, path=None):
    """The version keys (see build_key) of the validated DroidDeck-Proton builds, or None when the pin is off."""
    order = validated_own_order(environ, path)
    return None if order is None else set(order)


def preferred_own_build(builds, environ=None):
    """Of the DroidDeck-Proton catalog entries `builds`: the validated one first in preference order (the default), else
    the newest one, else None."""
    if not builds:
        return None
    order = lambda t: (build_key(t["dir"]), t["dir"])
    validated = validated_own_order(environ)
    good = [t for t in builds if validated is not None and tuple(build_key(t["dir"])) in validated]
    if good:
        return min(good, key=lambda t: (validated.index(tuple(build_key(t["dir"]))), [-k for k in build_key(t["dir"])], t["dir"]))
    return max(builds, key=order)


def own_proton_moves(state, catalog, environ=None):
    """(the build to use, the DroidDeck-Proton builds that are gone since the last run). The build to use is the
    validated one installed first in the preference order (else the newest): a new upstream build that appears is not it."""
    names = {t["name"] for t in catalog}
    before = state.get("tools") if isinstance(state.get("tools"), list) else ()
    seen = state.get("own_builds") if isinstance(state.get("own_builds"), list) else []
    known = {n for n in seen if isinstance(n, str)} | {t["name"] for t in own_builds(before)} | {t["name"] for t in own_builds(catalog)}
    state["own_builds"] = sorted(known)
    best = preferred_own_build(own_builds(catalog), environ)
    if best is None:
        return None, set()
    return best["name"], known - names


def suggested_games(catalog, runnable=None, directory=None):
    """App id -> tool the app's known-games table suggests (known-games.json, written by the app:
    {"version": 1, "games": {"<appid>": {"valve": bool, "dir": "<tool dir>"}}}). A tool that is not
    there (or not runnable yet) is left out: the title follows the default meanwhile."""
    value = read_json(state_path("known-games.json", directory))
    if value.get("version") != 1 or not isinstance(value.get("games"), dict):
        return {}
    games = {app: request for app, request in value["games"].items() if request is not None}
    return {app: tool for app, tool in requested_games(games, catalog, runnable).items()
            if isinstance(tool, str)}


def now_ms():
    import time
    return int(time.time() * 1000)


def choose_default(steam_default, state, request, catalog, adopt_steam=True, apply_request=True, now=None, disk=None, picked=None, why=None):
    """`disk` (names of the tools installed, set when DD_COMPAT_RESPECT is on): a default that is installed
    stays the default even when `catalog` (what the client lists) misses it for the moment. `picked`: the
    tool the player chose for the general default in the client (see player_picks); config.vdf showing
    anything else without a newer ask from the app does not undo it. `why`: gets a text for "0"."""
    state = dict(state)
    why = why if why is not None else {}
    names = [t["name"] for t in catalog]
    seq = request.get("seq")
    seq = seq if isinstance(seq, int) else 0
    if apply_request and seq > int(state.get("applied", 0) or 0):
        wanted = requested_tool(request, catalog)
        state["applied"] = seq
        if wanted:
            if wanted != state.get("default"):
                why["0"] = "the app asked for %s (was %s)" % (wanted, state.get("default") or TOOL)
                state.update(default=wanted, seq=now or now_ms(), source="app")
            if isinstance(state.get("chosen"), dict):
                state["chosen"] = {a: c for a, c in state["chosen"].items() if a != "0"}
        else:
            print("steam-compatibility: the app asked for %s, which is not installed; kept %s" % (
                request.get("name") or request.get("dir"), state.get("default") or TOOL))
    elif adopt_steam and steam_default in names and steam_default != state.get("default"):
        if picked is not None and picked in names and picked == state.get("default"):
            why["0"] = "kept %s, which you picked in Steam; the client's config said %s" % (picked, steam_default)
        else:
            why["0"] = "you changed it in Steam (was %s)" % (state.get("default") or TOOL)
            state.update(default=steam_default, seq=now or now_ms(), source="steam")
    if state.get("default") not in names and not (disk and state.get("default") in disk):
        state["default"] = TOOL
    return state["default"], state


def mapping_block(tokens):
    steam = find_block(tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return None
    mapping = find_block(tokens[steam + 1:], ["CompatToolMapping"])
    if mapping is None:
        end = block_end(tokens, steam)
        tokens[end:end] = ['"CompatToolMapping"', "{", "}"]
        return end + 1
    return mapping + steam + 1


def read_mapping(tokens, mapping):
    current = {}
    end = block_end(tokens, mapping)
    i = mapping + 1
    while i < end:
        if i + 1 < end and tokens[i + 1] == "{":
            close = block_end(tokens, i + 1)
            name = ""
            for j in range(i + 2, close - 1):
                if tokens[j] == '"name"':
                    name = tokens[j + 1].strip('"')
                    break
            current[tokens[i].strip('"')] = name
            i = close + 1
        else:
            i += 2
    return current


def read_config_mapping(config_path):
    """Read per-app choices without creating or rewriting the client's mapping block."""
    try:
        with open(config_path, encoding="utf-8", errors="replace") as f:
            tokens = tokenize(f.read())
    except OSError:
        return None
    depth = 0
    for token in tokens:
        if token == "{":
            depth += 1
        elif token == "}":
            depth -= 1
            if depth < 0:
                return None
    if depth != 0:
        return None
    steam = find_block(tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return None
    mapping = find_block(tokens[steam + 1:], ["CompatToolMapping"])
    return read_mapping(tokens, mapping + steam + 1) if mapping is not None else {}


def set_mapping(tokens, mapping, app, tool):
    block = find_block(tokens[mapping + 1:], [app])
    if tool is None:
        if block is not None:
            block += mapping + 1
            del tokens[block - 1:block_end(tokens, block) + 1]
        return
    if block is None:
        tokens[mapping + 1:mapping + 1] = [
            '"%s"' % app, "{", '"name"', '"%s"' % tool, '"config"', '""', '"priority"', '"75"' if app == "0" else '"250"', "}"]
        return
    block += mapping + 1
    end = block_end(tokens, block)
    for i in range(block + 1, end):
        if tokens[i] == '"name"':
            tokens[i + 1] = '"%s"' % tool
            return
    tokens[block + 1:block + 1] = ['"name"', '"%s"' % tool]


def steam_running():
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0]
        except OSError:
            continue
        if argv0.endswith(b"steamrtarm64/steam"):
            return True
    return False


def game_running():
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                if b"\0SteamLaunch\0AppId=" in f.read():
                    return True
        except OSError:
            continue
    return False


def live_helper_running(directory=None):
    try:
        with open(state_path("live.pid", directory)) as f:
            pid = int(f.read().split()[0])
        os.kill(pid, 0)
        return True
    except (OSError, ValueError, IndexError):
        return False


def change_lines(changes, why, held, current):
    """One line per title (and the default) the run changes, or holds back, and why."""
    lines = []
    for app, tool in sorted(changes.items(), key=lambda item: app_order(item[0])):
        label = "default" if app == "0" else "app %s" % app
        if app in held:
            lines.append("%s: kept %s (it would move to %s: %s)" % (label, held[app], tool, why.get(app, "")))
        else:
            lines.append("%s: %s -> %s (%s)" % (label, current.get(app) or "nothing", tool if tool is not None else "Steam's own default",
                                                why.get(app, "")))
    return lines


# --- Undo of v0.5.5.2's own moves onto an unvalidated build (release prep T11, owner 11-04; a player log 11-05) --------------------
# v0.5.5.2 put DroidDeck-Proton 11-12.1 (never validated) under players: the default "0", the titles that follow it, the titles
# it started on its own and its start-failure moves; it also moved titles off the build it deleted without a record. Those were
# the app's decisions. At every start (not once: a player log, test12, kept 11-12.1 as the default and 108 titles on it with no line
# at all, because its record was not source "update" or had been moved back once already), a DroidDeck-Proton build that
# MaliBridge did not validate stays the default, or stays under a title, only when a record shows the PLAYER picked it:
#   - a pick in the client's menu, which the live helper sees (CompatManager.SpecifyCompatTool, since v0.5.5.2): state "chosen";
#   - the app's general default asked for in the app (request.json, state source "app"), or a per-game pick in the app
#     (games.json);
#   - a title that follows a general default the player picked (above).
# Anything else on it (source "update", "steam" without a menu pick seen - the client's config or a stale state, a mapping
# nobody recorded, the app's new-title and start-failure moves) goes to the default validated build, with a line saying why and
# how to keep the build (pick it in Steam's menu or in the app). Nothing moves when no validated build is installed, with the pin
# off, or with DD_PROTON_MOVE_BACK=0. state "moved_back" records the last move of each title (for the logs), it does not stop one.

def move_back_enabled(environ=None):
    value = (os.environ if environ is None else environ).get("DD_PROTON_MOVE_BACK", "1")
    return value.strip().lower() not in ("0", "off", "false", "no")


def unvalidated_own(name, catalog, environ=None):
    """Whether `name` is a DroidDeck-Proton build of `catalog` that MaliBridge did not validate (False with the pin off)."""
    validated = validated_own_builds(environ)
    if validated is None or not name:
        return False
    return any(t["name"] == name and tuple(build_key(t["dir"])) not in validated for t in own_builds(catalog))


def validated_default_build(catalog, environ=None):
    """The default validated DroidDeck-Proton build installed (see preferred_own_build), or None when none is installed."""
    validated = validated_own_builds(environ)
    best = preferred_own_build(own_builds(catalog), environ)
    return best["name"] if best and validated is not None and tuple(build_key(best["dir"])) in validated else None


def player_default(state, default, chosen):
    """Whether a record shows the player picked `default` as the general default: in the client's menu (state "chosen", seen
    by the live helper) or in the app (an applied request.json, state source "app")."""
    return (chosen.get("0") or {}).get("name") == default or (state.get("source") == "app" and state.get("default") == default)


def default_origin(state, default, chosen):
    """A short text for the session log: who set the general default, as far as the state shows."""
    if (chosen.get("0") or {}).get("name") == default:
        return "picked in Steam's menu"
    source = state.get("source")
    return {"app": "picked in the app", "update": "set by the app", "steam": "taken from the client's config (no pick in "
            "Steam's menu seen)"}.get(source, "no record of who set it")


def move_back_default(state, default, chosen, catalog, why, lines, environ=None, now=None):
    """The general default after the undo: the default validated build when `default` is an unvalidated DroidDeck-Proton build
    that no record shows the player picked (see above)."""
    if not move_back_enabled(environ) or not unvalidated_own(default, catalog, environ):
        return default
    if player_default(state, default, chosen):
        return default
    target = validated_default_build(catalog, environ)
    if not target:
        return default
    origin = default_origin(state, default, chosen)
    why["0"] = "moved back to %s: %s is not a build MaliBridge validated and nothing shows you picked it (%s)" % (
        target, default, origin)
    state.update(default=target, seq=now or now_ms(), source="update")
    state.setdefault("moved_back", {})["0"] = {"from": default, "to": target, "at": now or now_ms(), "origin": origin}
    lines.append("default: moved back from %s to %s (%s; not validated by MaliBridge; to keep it, pick it in Steam's menu or "
                 "in the app)" % (default, target, origin))
    return target


# RP4 Pro build: Proton Experimental ARM64 stays the default and new titles start on it; DroidDeck-Proton is a per-game pick.
# The RP4 Pro fixes were tested on Experimental, and on DroidDeck-Proton 11-11.10 Turtles' audio stutters there.
# DD_PROTON_OWN_DEFAULT=1 restores upstream's choice.

def own_default_enabled(environ=None):
    value = (os.environ if environ is None else environ).get("DD_PROTON_OWN_DEFAULT", "0")
    return value.strip().lower() not in ("0", "off", "false", "no")


def keep_valve_default(state, default, chosen, catalog, why, lines, environ=None, now=None):
    """The general default: TOOL when `default` is a DroidDeck-Proton build that no record shows the player picked."""
    if own_default_enabled(environ) or not any(t["name"] == default for t in own_builds(catalog)):
        return default
    if player_default(state, default, chosen):
        return default
    origin = default_origin(state, default, chosen)
    why["0"] = "Proton Experimental ARM64 is this build's default (%s was %s)" % (default, origin)
    state.update(default=TOOL, seq=now or now_ms(), source="update")
    lines.append("default: %s -> %s (%s; to keep DroidDeck-Proton, pick it in Steam's menu or in the app)" % (default, TOOL, origin))
    return TOOL


def move_back_games(state, current, default, overrides, chosen, requests, catalog, steam_root, why, lines, environ=None, now=None):
    """{app: target}: the titles on an unvalidated DroidDeck-Proton build that no record shows the player picked (see above),
    which go to the default validated build, and the set of them that follow the default (they stay followers)."""
    if not move_back_enabled(environ):
        return {}, set()
    target = validated_default_build(catalog, environ)
    if not target:
        return {}, set()
    auto = state.get("auto") if isinstance(state.get("auto"), dict) else {}
    new_titles = state.get("new_title_tools") if isinstance(state.get("new_title_tools"), dict) else {}
    records = state.get("fallbacks") if isinstance(state.get("fallbacks"), dict) else {}
    moves, follow = {}, set()
    for app, name in sorted(current.items(), key=lambda item: app_order(item[0])):
        if app == "0" or app in chosen or app in requests or app in overrides:
            continue  # the player's pick in the client or the app
        if not unvalidated_own(name, catalog, environ):
            continue
        record = records.get(app) if isinstance(records.get(app), dict) else None
        if new_titles.get(app) == name:
            how = "the app started this new title on %s on its own" % name
            new_titles[app] = target
        elif record is not None and record.get("to") == name:
            how = "the app's start-failure guard had moved it to %s" % name
            record["to"] = target
        elif name == default:
            continue  # it is on the general default, which the player picked (move_back_default kept it)
        elif auto.get(app) == name:
            how = "it followed a default that was on %s" % name
            follow.add(app)
        else:
            how = "no pick of %s for it in Steam's menu or the app was seen" % name
        moves[app] = target
        why[app] = "moved back to %s: %s; your own picks are never moved" % (target, how)
        state.setdefault("moved_back", {})[app] = {"from": name, "to": target, "at": now or now_ms()}
        lines.append("app %s (%s): moved back from %s to %s (%s; to keep it, pick it in Steam's menu or the app)" % (
            app, app_title(steam_root, app) or app, name, target, how))
    return moves, follow


def register_default(config_path, apps=(), protect=(), default=None, catalog=None, directory=None, settle=False, picks=(),
                     linux_tool=FEX_TOOL):
    """Writes the mapping: the "0" default and every title that follows it (see plan_mapping).
    With settle, the default itself is decided first (see choose_default): before the client
    starts, config.vdf holds what the client last kept, menu changes included."""
    with locked(directory):
        state = read_json(state_path("state.json", directory))
        with open(config_path, encoding="utf-8", errors="replace") as f:
            original = f.read()
        tokens = tokenize(original)
        mapping = mapping_block(tokens)
        if mapping is None:
            return state.get("default") or TOOL
        current = read_mapping(tokens, mapping)
        steam_root = os.path.dirname(os.path.dirname(os.path.abspath(config_path)))
        if catalog is None:
            catalog = tool_catalog(steam_root, dict(protect) if isinstance(protect, dict) else {name: name for name in protect})
        names = [t["name"] for t in catalog]
        respect = respect_enabled()
        why, restore, chosen, picked = {}, {}, {}, None
        if respect:
            try:
                saved_at = int(os.stat(config_path).st_mtime * 1000)
            except OSError:
                saved_at = None
            chosen, _, restore, lines = settle_picks(state, current, (), False, saved_at)
            state["chosen"] = chosen
            for line in lines:
                print("steam-compatibility: " + line)
            picked = chosen.get("0", {}).get("name")
        newest, gone = own_proton_moves(state, catalog)
        previous, applied, chosen_seq = state.get("default"), state.get("applied"), state.get("seq")
        if default is None:
            if settle:
                default, state = choose_default(current.get("0", ""), state, read_json(state_path("request.json", directory)), catalog,
                                                disk=set(names) if respect else None, picked=picked, why=why)
            else:
                default = state.get("default") if state.get("default") in names else TOOL
            # On the Mali bridge, an install that already has games keeps its Proton (and so its prefixes and
            # pipeline caches) when DroidDeck-Proton first arrives; it is one pick away in the app.
            keeps = (os.environ.get("BL_VKBRIDGE") == "1" and previous and apps and previous not in gone
                     and not state.get("own_proton"))
            if settle and newest and default == TOOL and state.get("applied") == applied and state.get("seq") == chosen_seq and (
                    previous in gone or not state.get("own_proton")):
                if keeps:
                    print("steam-compatibility: Mali bridge: kept %s as the default for the installed games; %s is in the list" % (
                        default, newest))
                else:
                    default = newest
                    why["0"] = "%s is the newest DroidDeck-Proton build" % newest
                    state.update(default=newest, seq=now_ms(), source="update")
            if settle and newest:
                state["own_proton"] = True
            if settle:
                back_lines = []
                default = move_back_default(state, default, chosen, catalog, why, back_lines)
                default = keep_valve_default(state, default, chosen, catalog, why, back_lines)
                for line in back_lines:
                    print("steam-compatibility: " + line)
                if any(t["name"] == default for t in own_builds(catalog)):
                    print("steam-compatibility: default %s: %s%s" % (default, default_origin(state, default, chosen),
                          "; not validated by MaliBridge" if unvalidated_own(default, catalog) else ""))
        if newest:
            for app, name in list(current.items()):
                if app != "0" and name in gone:
                    set_mapping(tokens, mapping, app, newest)
                    current[app] = newest
                    print("steam-compatibility: app %s: %s -> %s (%s was removed)" % (app, name, newest, name))
            if isinstance(state.get("auto"), dict):
                state["auto"] = {app: newest if name in gone else name for app, name in state["auto"].items()}
        requests = settled_game_requests(state, current, catalog, not steam_running(), directory)
        overrides = requested_games(requests or {}, catalog)
        follow = followers(state, current)
        managed = set(state.get("auto", {})) if isinstance(state.get("auto"), dict) else set()
        if respect:
            pinned = pinned_apps(chosen, current)
            follow = {app: tool for app, tool in follow.items() if app not in pinned}
            managed -= pinned
            for app, name in restore.items():
                if name in names and app not in overrides:
                    overrides[app] = name
        native_choices = state.get("native_choices", ())
        native = native_targets(steam_root, set(apps) | set(picks) | set(managed) | set(native_choices))
        if linux_tool != FEX_TOOL:
            native = {app: linux_tool if tool == FEX_TOOL else tool for app, tool in native.items()}
        for app in picked_apps(state) & set(native):
            current.setdefault(app, "")
        fallback_lines, moved_why, new_tools = [], {}, {}
        if fallback_enabled():
            settle_pending_fallbacks(state, steam_root, catalog, names, overrides, chosen, fallback_lines)
            overrides.update(settle_fallbacks(state, current, overrides, chosen, set(names), set(names), moved_why, fallback_lines))
            new_tools = new_title_tools(steam_root, state, sorted(set(apps) | set(picks), key=app_order), catalog, names, default, chosen, native,
                                        {app for app, tool in overrides.items() if tool is not None})
            for line in fallback_lines:
                print("steam-compatibility: " + line)
        back_follow = set()
        if settle:
            back_lines = []
            back, back_follow = move_back_games(state, current, default, overrides, chosen, requests or {}, catalog, steam_root,
                                                moved_why, back_lines)
            overrides.update(back)
            for line in back_lines:
                print("steam-compatibility: " + line)
        changes, auto = plan_mapping(
            current, apps, names, default, follow, native, picks,
            overrides, managed, native_choices, suggested_games(catalog, names, directory), why=why,
            new_tools=new_tools, override_why=moved_why)
        for app in back_follow:
            auto[app] = overrides[app]  # moved back, and still follows the default
        for app in restore:
            if app in changes and overrides.get(app) == restore[app]:
                why[app] = "your pick %s, which the client had not saved" % restore[app]
        cache = {}
        allowed, held = guard_prefixes(steam_root, changes, why, current, catalog, names, overrides, hold=respect, cache=cache)
        for app, name in held.items():
            auto[app] = name
        for line in change_lines(changes, why, held, current):
            print("steam-compatibility: " + line)
        for app, tool in allowed.items():
            set_mapping(tokens, mapping, app, tool)
        remember_new_title_tools(state, new_tools, allowed, auto)
        text = serialize(tokens)
        if text != serialize(tokenize(original)):
            write_changed(config_path, text)
        effective = {app: allowed[app] if app in allowed else name for app, name in current.items()}
        effective.update({app: tool for app, tool in allowed.items() if tool})
        effective = {app: (name or effective.get("0") or default) for app, name in effective.items()}
        warnings = prefix_warnings(steam_root, effective, catalog, cache)
        for app, text_ in warnings.items():
            print("steam-compatibility: WARNING " + text_)
        state["prefix_warnings"] = warnings
        for line in valve_build_changes(steam_root, state):
            print("steam-compatibility: " + line)
        state["auto"] = {app: tool for app, tool in auto.items() if tool is not NATIVE_CHOICE}
        state["native_choices"] = sorted(app for app, tool in auto.items() if tool is NATIVE_CHOICE)
        state["picked"] = picked_after(current, allowed)
        state["games_applied"] = applied_game_requests(requests, overrides, state)
        state.pop("native", None)
        state["tools"] = catalog
        state.setdefault("default", default)
        write_json(state_path("state.json", directory), state)
    return default


def depot_build(depot):
    """The build number a depot's version file starts with; 0 when there is none."""
    try:
        with open(os.path.join(depot, "version"), encoding="utf-8", errors="replace") as f:
            first = f.read().split(None, 1)
    except OSError:
        return 0
    return int(first[0]) if first and first[0].isdigit() else 0


def find_source(steam_root, sources=SOURCES):
    """The first of `sources` the client has downloaded, newest across the libraries holding it."""
    for name in sources:
        found = [os.path.join(root, "steamapps", "common", name) for root in libraries(steam_root)
                 if os.path.isdir(os.path.join(root, "steamapps", "common", name, "files", "bin-arm64"))]
        if found:
            return max(found, key=depot_build)
    return None


def build_tool(tool_dir, depot, sources=SOURCES, name=TOOL):
    """Our own manifests and the launcher, named after `depot`. The depot is run at launch time."""
    if os.path.islink(tool_dir):
        os.unlink(tool_dir)
    elif os.path.isdir(tool_dir) and set(os.listdir(tool_dir)) - set(OWN_FILES):
        shutil.rmtree(tool_dir)
    os.makedirs(tool_dir, exist_ok=True)
    write_changed(os.path.join(tool_dir, "toolmanifest.vdf"), TOOL_MANIFEST_VDF)
    write_changed(os.path.join(tool_dir, "compatibilitytool.vdf"), COMPAT_TOOL_VDF % (name, display_name(
        os.path.basename(depot).replace(" (ARM64)", " ARM64") if depot else "Proton ARM64")))
    write_changed(os.path.join(tool_dir, LAUNCHER), launcher_sh(sources), 0o755)


def build_fex_tool(tool_dir):
    if os.path.islink(tool_dir):
        os.unlink(tool_dir)
    elif os.path.isdir(tool_dir) and set(os.listdir(tool_dir)) - set(FEX_FILES):
        shutil.rmtree(tool_dir)
    os.makedirs(tool_dir, exist_ok=True)
    write_changed(os.path.join(tool_dir, "toolmanifest.vdf"), FEX_MANIFEST_VDF)
    write_changed(os.path.join(tool_dir, "compatibilitytool.vdf"), FEX_COMPAT_TOOL_VDF % (FEX_TOOL, display_name("Linux x86 (FEX)")))
    write_changed(os.path.join(tool_dir, FEX_LAUNCHER), FEX_LAUNCHER_SH, 0o755)


def remove_tool(tool_dir):
    if os.path.isdir(tool_dir) and not os.path.islink(tool_dir) and not set(os.listdir(tool_dir)) - set(OWN_FILES) - {LEGACY_LAUNCHER}:
        shutil.rmtree(tool_dir)


def local_tools(steam_root):
    """The names of the compatibility tools installed in steam_root/compatibilitytools.d."""
    names = set()
    tools = os.path.join(steam_root, "compatibilitytools.d")
    try:
        entries = os.listdir(tools)
    except OSError:
        return names
    for entry in entries:
        try:
            with open(os.path.join(tools, entry, "compatibilitytool.vdf"), encoding="utf-8", errors="replace") as f:
                m = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', f.read())
        except OSError:
            continue
        if m:
            names.add(m.group(1).lower())
    return names


def x64_repoint(steam_root, tool, live=False):
    """The x86-64 client (droiddeck-steam-x64): its tools are arm64 wrappers that script makes and
    its Linux titles run as Linux builds (FEX), so only the entries the client aimed at a Proton it
    cannot start are repointed, to `tool`. Tools in its own compatibilitytools.d are kept: the
    wrappers include proton-cachyos-*-a64, which starts with "proton" like Valve's own.
    Returns the app ids repointed."""
    config = os.path.join(steam_root, "config", "config.vdf")
    if not tool or not os.path.isfile(config):
        return []
    with open(config, encoding="utf-8", errors="replace") as f:
        original = f.read()
    tokens = tokenize(original)
    mapping = mapping_block(tokens)
    if mapping is None:
        return []
    keep = local_tools(steam_root)
    moved = []
    current = read_mapping(tokens, mapping)
    if "0" not in current:
        set_mapping(tokens, mapping, "0", tool)
    for app, name in current.items():
        named = name.lower()
        # A tool named arm64 is never this client's (its wrappers are -a64), so this legacy name is always repointed.
        legacy = named == "droiddeck-proton-arm64"
        if (named.startswith("proton") or legacy) and named != tool.lower() \
                and (legacy or named not in keep):
            set_mapping(tokens, mapping, app, tool)
            if app != "0":
                moved.append(app)
    text = serialize(tokens)
    if text != serialize(tokenize(original)):
        write_changed(config, text)
    print("steam-compatibility: x86-64 client's Proton entries point at %s" % tool)
    # Steam reads a mapping changed while it runs only at its next start; the session restarts it (.bl-compat-pending).
    if moved and live:
        with open(os.path.join(os.path.expanduser("~"), ".bl-compat-pending"), "a") as f:
            f.write("".join("%s\n" % a for a in moved))
        print("steam-compatibility: repointed while the client runs: %s" % " ".join(moved))
    return moved


def main():
    steam_root = sys.argv[1]
    if "--x64" in sys.argv[2:]:
        x64_repoint(steam_root, os.environ.get("BL_COMPAT_TOOL"), "--live" in sys.argv[2:])
        return
    tools = os.path.join(steam_root, "compatibilitytools.d")
    os.makedirs(tools, exist_ok=True)
    legacy = os.path.join(tools, LEGACY_TOOL)
    if os.path.islink(legacy):
        os.unlink(legacy)
    elif os.path.isdir(legacy):
        shutil.rmtree(legacy)
    for name, sources in OWN_TOOLS:
        depot = find_source(steam_root, sources)
        if depot is None and name != TOOL:
            remove_tool(os.path.join(tools, name))
            continue
        build_tool(os.path.join(tools, name), depot, sources, name)
        print("steam-compatibility: registered %s (%s)" % (
            name, "depot %s present" % os.path.basename(depot) if depot else
            "no ARM64 Proton depot yet; the session asks the client to fetch it"))
    build_fex_tool(os.path.join(tools, FEX_TOOL))
    print("steam-compatibility: registered %s" % FEX_TOOL)
    extras = adopt_extras(tools)
    for name, directory in sorted(extras.items()):
        print("steam-compatibility: adopted %s as %s" % (directory, name))
    catalog = tool_catalog(steam_root, extras)
    config = os.path.join(steam_root, "config", "config.vdf")
    if live_helper_running():
        with locked():
            state = read_json(state_path("state.json"))
            state["tools"] = catalog
            write_json(state_path("state.json"), state)
        print("steam-compatibility: the live helper keeps the client's mapping; tools listed")
    elif os.path.isfile(config):
        apps = installed_apps(steam_root)
        picks = valve_picks(steam_root)
        default = register_default(config, apps, protect=extras, catalog=catalog, settle=not steam_running(), picks=picks)
        print("steam-compatibility: default, %d installed title(s) and %d title(s) with a Valve pick set to %s" % (len(apps), len(picks), default))
    sync = os.path.join(os.path.dirname(os.path.realpath(__file__)), "droiddeck-esync")
    if os.path.isfile(sync):
        try:
            summary = runpy.run_path(sync)["reconcile"](steam_root, os.environ)
        except Exception as e:
            summary = "droiddeck-esync: reconcile failed (%s)" % e
        if summary:
            print("steam-compatibility: %s" % summary)


if __name__ == "__main__":
    main()
