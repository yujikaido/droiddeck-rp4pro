    return (LAUNCHER_TEMPLATE % " ".join('"%s"' % n for n in sources)).replace(
        "verb=$1; shift", "verb=$1; shift\n" + BL_DRIVER_QUERY_SKIP + BL_DESKTOP_GPU_SETUP + BL_DIRECTAUDIO_SETUP + BL_GAME_CPUS_SETUP + BL_IDTECH3_SETUP
        + BL_VACDIAG_SETUP + BL_COMPONENTS_SETUP + BL_FIXUPS_SETUP + BL_LIBPATH_SETUP + BL_STORE_SETUP, 1)


